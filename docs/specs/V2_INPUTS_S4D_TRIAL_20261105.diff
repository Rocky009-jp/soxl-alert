+"""TRIAL. The user's F&G observations: observations.csv on refs/heads/<ref>, read at the fetched head SHA. The rows are
+passed to the core as text (the core parses them); only the header, the encoding and observed_at <= now are checked."""
+import csv, io
+from v2_core.errors import CoreError, InputError
+from v2_core.sessions import parse_aware_datetime
+
+NAME = "observations.csv"
+COLUMNS = ("record_id", "target_us_session_date", "observation_role", "observation_status", "current_fg_value",
+           "observed_at_iso8601")
+
+
+def read_ledger(git, ref, now):
+    """(rows, head SHA). Raises InputError for a missing ledger, a bad file or a row observed after now."""
+    head = git.fetch(ref)
+    data = None if head is None else git.blob(head, NAME)
+    if data is None:
+        raise InputError("input_ledger_missing", "ledger")
+    header = body = None
+    try:
+        text = data.decode("utf-8-sig")
+        reader = csv.reader(io.StringIO(text, newline=""))
+        header = next(reader)
+        body = [r for r in reader if any(c.strip() for c in r)]
+    except (UnicodeDecodeError, csv.Error, StopIteration):
+        pass
+    if body is None:
+        raise InputError("input_ledger_unreadable", "ledger")
+    if tuple(h.strip() for h in header) != COLUMNS:
+        raise InputError("input_ledger_header_invalid", "ledger")
+    rows = []
+    for r in body:
+        if len(r) != len(COLUMNS):
+            raise InputError("input_ledger_row_invalid", "ledger")
+        row = dict(zip(COLUMNS, (c.strip() for c in r)))
+        if row["observed_at_iso8601"]:
+            when = None
+            try:
+                when = parse_aware_datetime(row["observed_at_iso8601"], "observed_at_iso8601")
+            except CoreError:
+                pass                                   # the core reports a bad time itself
+            if when is not None and when > now:
+                raise InputError("input_ledger_observation_after_now", "observed_at_iso8601")
+        rows.append(row)
+    return rows, head
diff --git a/v2_inputs/load.py b/v2_inputs/load.py
new file mode 100644
index 0000000..86d4ef2
--- /dev/null
+++ b/v2_inputs/load.py
@@ -0,0 +1,144 @@
+"""TRIAL. load_inputs: sessions + pinned market series + ledger; any input failure is returned (not raised) and turned
+into a STOPPED report by guarded_store (its read raises it inside run_morning), so the morning still sends one notice."""
+import datetime as dt, hashlib
+from v2_core.errors import CoreError, InputError
+from v2_git_store import GitError
+from v2_git_store.git import check_ref
+from .xnys import build_sessions, coverage_failure, calendar_sha256, ny_offset
+from .market import SYMBOLS, PREHISTORY_START, parse_chart, snapshot_bytes, read_snapshot, series_of, MarketPin
+from .ledger import read_ledger
+
+MARGIN = dt.timedelta(minutes=60)
+_GIT_FAILED = object()
+
+
+class Inputs(object):
+    def __init__(self, series, sessions, raw, failure, provenance):
+        self.series, self.sessions, self.raw_observations = series, sessions, raw
+        self.failure, self.provenance = failure, provenance
+
+
+class _Guard(object):
+    def __init__(self, store, failure):
+        self._s, self._f = store, failure
+
+    def read(self):
+        raise self._f
+
+    def publish(self, p):
+        return self._s.publish(p)
+
+    def reconcile(self, p):
+        return self._s.reconcile(p)
+
+
+def guarded_store(store, failure):
+    return store if failure is None else _Guard(store, failure)
+
+
+def _last_complete(sessions_closed, by_symbol, now):
+    """The last session date (in order, without a hole) with a row for every symbol; InputError for a hole followed by
+    data, or a data day the calendar does not have."""
+    last, hole = None, None
+    table = set(s.date for s in sessions_closed)
+    first = sessions_closed[0].date if sessions_closed else None
+    for s in SYMBOLS[:3]:
+        extra = [d for d in by_symbol[s] if first is not None and d >= first and d not in table]
+        if extra:
+            raise InputError("input_calendar_data_mismatch", "market", detail=min(extra))
+    for s in sessions_closed:
+        if s.close_at + MARGIN > now:
+            break
+        have = all(s.date in by_symbol[x] for x in SYMBOLS)
+        if not have:
+            hole = s.date
+            continue
+        if hole is not None:
+            raise InputError("input_market_rows_missing", "market", detail=hole)
+        last = s.date
+    return last
+
+
+def _args_ok(now, refs, fetch, clock):
+    if not isinstance(now, dt.datetime) or now.utcoffset() is None or not callable(fetch) or not callable(clock):
+        return False
+    if not isinstance(refs, dict) or sorted(refs) != ["ledger", "market"]:
+        return False
+    try:
+        for r in refs.values():
+            check_ref(r)
+    except CoreError:
+        return False
+    return True
+
+
+def _fetch_all(fetch, end):
+    """({symbol: rows}, None) or (None, InputError); a fetch exception is input_market_fetch_failed."""
+    out = {}
+    for s in SYMBOLS:
+        try:
+            data = fetch(s, PREHISTORY_START, end)
+        except Exception:
+            data = _FAILED
+        if data is _FAILED:
+            return None, InputError("input_market_fetch_failed", "market")
+        out[s] = parse_chart(data, s)[0]
+    if PREHISTORY_START not in out["SOXX"]:
+        return None, InputError("input_market_history_short", "market", detail=PREHISTORY_START)
+    return out, None
+
+
+_FAILED = object()
+
+
+def load_inputs(git, fetch, now, refs, clock):
+    """fetch(symbol, start, end) -> bytes of the chart JSON (S4-E gives the HTTP one). refs: {"market": ..., "ledger": ...}."""
+    if not _args_ok(now, refs, fetch, clock):
+        raise InputError("input_args_invalid", "inputs")
+    prov, failure = {"calendar_sha256": calendar_sha256(), "fetch_count": 0}, None
+    skeleton = build_sessions(now, None)                         # raises only when now is past the table
+    end = ((now.astimezone(dt.timezone.utc) + ny_offset(now.astimezone(dt.timezone.utc).date())).date()
+           + dt.timedelta(days=1)).isoformat()
+    closed = [s for s in skeleton.sessions if s.close_at <= now]
+    pin = MarketPin(git, refs["market"], clock)
+    through, rows, series = None, None, None
+    try:
+        head, through, rows, digest = pin.read()
+        target = closed[-1].date if closed else None
+        if through is not None and through >= target:
+            prov["pinned_by"] = "existing"
+        else:
+            prov["fetch_count"] = len(SYMBOLS)
+            fetched, err = _fetch_all(fetch, end)
+            if err is not None:
+                raise err
+            last = _last_complete(closed, fetched, now)
+            if last is not None and (through is None or last > through):
+                data = snapshot_bytes(last, fetched)
+                if not pin.pin(head, data, last):
+                    head, through, rows, digest = pin.read()        # the other run's pin wins; use it as it is
+                    if through is None or through < last:
+                        raise InputError("input_market_pin_failed", "market")
+                    prov["pinned_by"] = "other"
+                else:
+                    through, rows, digest = last, read_snapshot(data)[1], hashlib.sha256(data).hexdigest()
+                    head = pin.head_after_pin
+                    prov["pinned_by"] = "this"
+        if through is None:
+            raise InputError("input_market_unavailable", "market")
+        series = series_of(through, rows, digest)
+        short = coverage_failure(now)
+        if short is not None:
+            raise short
+        prov.update(market_through=through, market_sha256=digest)
+        prov["market_commit"] = head
+        raw, lsha = read_ledger(git, refs["ledger"], now)
+        prov["ledger_commit"] = lsha
+    except GitError:                                               # a CoreError too: caught first and replaced
+        failure, raw = _GIT_FAILED, []
+    except CoreError as e:
+        failure, raw = e, []
+    if failure is _GIT_FAILED:
+        failure = InputError("input_git_failed", "inputs")
+    sessions = build_sessions(now, through)
+    return Inputs(series, sessions, raw if failure is None else [], failure, prov)
diff --git a/v2_inputs/market.py b/v2_inputs/market.py
new file mode 100644
index 0000000..98a4cff
--- /dev/null
+++ b/v2_inputs/market.py
@@ -0,0 +1,140 @@
+"""TRIAL. Market series from Yahoo chart (v8) JSON bytes, the pinned snapshot on refs/heads/<ref> (market.json)."""
+import datetime as dt, hashlib, json, math
+from v2_core.errors import InputError
+from v2_core.fixture import MarketSeries, PRICE_DEF_SOXX, PRICE_DEF_SOXL_CLOSE
+from .xnys import ny_offset
+
+SYMBOLS = ("SOXX", "SPY", "IEF", "SOXL")
+PREHISTORY_START = "2010-02-11"
+PRICE_MAX = 1e6
+NAME = "market.json"
+SCHEMA = "v2_inputs.market.1"
+
+
+def _price(x):
+    return isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x) and 0 < x < PRICE_MAX
+
+
+_BASE = "https://query1.finance.yahoo.com/v8/finance/chart/"
+
+
+def chart_url(symbol, start, end):
+    """The chart (v8) daily URL of one symbol from start to end (dates, 00:00 UTC); a pure function the S4-E fetch uses."""
+    if symbol not in SYMBOLS:
+        raise InputError("input_args_invalid", "inputs")
+    secs = [int(dt.datetime.combine(dt.date.fromisoformat(x), dt.time(0), dt.timezone.utc).timestamp()) for x in (start, end)]
+    return "%s%s?period1=%d&period2=%d&interval=1d&events=div%%2Csplit&includeAdjustedClose=true" % (_BASE, symbol, *secs)
+
+
+def _columns(data, symbol):
+    """(timestamps, close, adjclose), or None for a response of the wrong shape (no exception is raised in a handler)."""
+    if type(data) is not bytes:
+        return None
+    try:
+        res = json.loads(data.decode("utf-8"))["chart"]["result"][0]
+        ts = res["timestamp"]
+        close = res["indicators"]["quote"][0]["close"]
+        adj = res["indicators"]["adjclose"][0]["adjclose"]
+        if res["meta"]["symbol"] != symbol or not (len(ts) == len(close) == len(adj)):
+            return None
+    except (ValueError, KeyError, IndexError, TypeError, UnicodeDecodeError, AttributeError):
+        return None
+    return ts, close, adj
+
+
+def parse_chart(data, symbol):
+    """{date: (close, adjclose)} of one symbol from PREHISTORY_START; a day with a null value has no row."""
+    cols = _columns(data, symbol)
+    if cols is None:
+        raise InputError("input_market_response_invalid", "market")
+    rows, invalid, seen = {}, None, set()
+    for t, c, a in zip(*cols):
+        if not isinstance(t, int) or isinstance(t, bool):
+            raise InputError("input_market_response_invalid", "market")
+        utc = dt.datetime.fromtimestamp(t, dt.timezone.utc)
+        day = (utc + ny_offset(utc.date())).date().isoformat()
+        if day in seen:
+            raise InputError("input_market_response_invalid", "market")
+        seen.add(day)
+        if day < PREHISTORY_START:
+            continue
+        if c is None or a is None:
+            continue                                  # not there (yet): a missing row, not a bad value
+        if _price(c) and _price(a):
+            rows[day] = (float(c), float(a))
+        elif invalid is None or day < invalid:
+            invalid = day
+    if invalid is not None:
+        raise InputError("input_market_value_invalid", "market", detail=invalid)
+    return rows, 0
+
+
+def snapshot_bytes(through, by_symbol):
+    body = {"schema": SCHEMA, "through": through, "source": "yahoo_chart_v8",
+            "symbols": {s: {"dates": sorted(d for d in by_symbol[s] if PREHISTORY_START <= d <= through),
+                            } for s in SYMBOLS}}
+    for s in SYMBOLS:
+        dates = body["symbols"][s]["dates"]
+        body["symbols"][s]["close"] = [by_symbol[s][d][0] for d in dates]
+        body["symbols"][s]["adjclose"] = [by_symbol[s][d][1] for d in dates]
+    return json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii")
+
+
+def _snapshot(data):
+    try:
+        body = json.loads(data.decode("ascii"))
+        if body["schema"] != SCHEMA:
+            return None
+        out = {}
+        for s in SYMBOLS:
+            e = body["symbols"][s]
+            if not (len(e["dates"]) == len(e["close"]) == len(e["adjclose"])):
+                return None
+            out[s] = {d: (c, a) for d, c, a in zip(e["dates"], e["close"], e["adjclose"])}
+            if not all(_price(c) and _price(a) for c, a in out[s].values()):
+                return None
+        return body["through"], out
+    except (ValueError, KeyError, TypeError, UnicodeDecodeError, AttributeError):
+        return None
+
+
+def read_snapshot(data):
+    got = _snapshot(data)
+    if got is None:
+        raise InputError("input_market_pin_invalid", "market")
+    return got
+
+
+def series_of(through, by_symbol, digest):
+    soxx = by_symbol["SOXX"]
+    dates = sorted(d for d in soxx if PREHISTORY_START <= d <= through)
+    spy = {d: v[1] for d, v in by_symbol["SPY"].items() if d <= through}
+    ief = {d: v[1] for d, v in by_symbol["IEF"].items() if d <= through}
+    meta = {"source": "yahoo_chart_v8 (pinned)", "price_definition": PRICE_DEF_SOXX,
+            "soxl_close_definition": PRICE_DEF_SOXL_CLOSE, "prehistory_start": PREHISTORY_START,
+            "input_manifest": [{"file": NAME, "sha256": digest}]}
+    soxl = {d: v[0] for d, v in by_symbol["SOXL"].items() if d <= through}
+    return MarketSeries(dates, [soxx[d][1] for d in dates], spy, ief, set(spy) & set(ief), soxl_close=soxl, meta=meta)
+
+
+class MarketPin(object):
+    def __init__(self, git, ref, clock):
+        self._git, self._ref, self._clock = git, ref, clock
+        self.head_after_pin = None
+
+    def read(self):
+        """(head, through, by_symbol, sha256) of the pinned snapshot, or (None, None, None, None)."""
+        head = self._git.fetch(self._ref)
+        if head is None:
+            return None, None, None, None
+        data = self._git.blob(head, NAME)
+        if data is None:
+            raise InputError("input_market_pin_invalid", "market")
+        through, rows = read_snapshot(data)
+        return head, through, rows, hashlib.sha256(data).hexdigest()
+
+    def pin(self, head, data, through):
+        from v2_git_store import OK
+        commit = self._git.commit_with(head, NAME, data, "v2 market through %s" % through, self._clock())
+        self.head_after_pin = commit
+        return self._git.push(commit, self._ref) == OK
diff --git a/v2_inputs/xnys.py b/v2_inputs/xnys.py
new file mode 100644
index 0000000..8de5fe5
--- /dev/null
+++ b/v2_inputs/xnys.py
@@ -0,0 +1,71 @@
+"""TRIAL. XNYS sessions from a fixed table (no calendar library, no tz database): weekdays minus holidays, 09:30-16:00
+(13:00 on early closes) New York time, with the US DST rule (second Sunday of March .. first Sunday of November)."""
+import datetime as dt, hashlib
+from v2_core.errors import InputError
+from v2_core.sessions import Session, SessionList
+
+CALENDAR_START = dt.date(2026, 1, 2)
+CALENDAR_END = dt.date(2028, 12, 29)
+HOLIDAYS = frozenset(dt.date.fromisoformat(x) for x in (
+    "2026-01-01", "2026-01-19", "2026-02-16", "2026-04-03", "2026-05-25", "2026-06-19", "2026-07-03", "2026-09-07",
+    "2026-11-26", "2026-12-25",
+    "2027-01-01", "2027-01-18", "2027-02-15", "2027-03-26", "2027-05-31", "2027-06-18", "2027-07-05", "2027-09-06",
+    "2027-11-25", "2027-12-24",
+    "2028-01-17", "2028-02-21", "2028-04-14", "2028-05-29", "2028-06-19", "2028-07-04", "2028-09-04", "2028-11-23",
+    "2028-12-25"))
+EARLY_CLOSES = frozenset(dt.date.fromisoformat(x) for x in (
+    "2026-11-27", "2026-12-24", "2027-11-26", "2028-07-03", "2028-11-24"))
+MARGIN_DAYS = 14
+
+
+def _nth_sunday(year, month, n):
+    d = dt.date(year, month, 1)
+    d += dt.timedelta((6 - d.weekday()) % 7)
+    return d + dt.timedelta(7 * (n - 1))
+
+
+def ny_offset(day):
+    """UTC offset of New York on a weekday (no session is on the Sunday of a change)."""
+    dst = _nth_sunday(day.year, 3, 2) <= day < _nth_sunday(day.year, 11, 1)
+    return dt.timedelta(hours=-4 if dst else -5)
+
+
+def _at(day, hh, mm):
+    return dt.datetime(day.year, day.month, day.day, hh, mm, tzinfo=dt.timezone(ny_offset(day)))
+
+
+def session_days():
+    day, out = CALENDAR_START, []
+    while day <= CALENDAR_END:
+        if day.weekday() < 5 and day not in HOLIDAYS:
+            out.append(day)
+        day += dt.timedelta(1)
+    return out
+
+
+def calendar_sha256():
+    """The version of the table: sha256 of its canonical text (the range, then the holidays, then the early closes)."""
+    text = "%s..%s|H:%s|E:%s" % (CALENDAR_START, CALENDAR_END, ",".join(sorted(d.isoformat() for d in HOLIDAYS)),
+                                 ",".join(sorted(d.isoformat() for d in EARLY_CLOSES)))
+    return hashlib.sha256(text.encode("ascii")).hexdigest()
+
+
+def coverage_failure(now):
+    """None, or InputError(input_calendar_not_covered) when now + MARGIN_DAYS is past the table (the sessions are
+    still built, so the run stops with the right D and sends its notice)."""
+    if (now.astimezone(dt.timezone.utc) + dt.timedelta(days=MARGIN_DAYS)).date() > CALENDAR_END:
+        return InputError("input_calendar_not_covered", "calendar")
+    return None
+
+
+def build_sessions(now, confirmed_through):
+    """Every table session from CALENDAR_START; confirmed only up to confirmed_through (a date text or None).
+    Raises InputError(input_calendar_ended) only when now itself is past the table."""
+    if now.astimezone(dt.timezone.utc).date() > CALENDAR_END:
+        raise InputError("input_calendar_ended", "calendar")
+    out = []
+    for day in session_days():
+        close = _at(day, 13, 0) if day in EARLY_CLOSES else _at(day, 16, 0)
+        ok = confirmed_through is not None and day.isoformat() <= confirmed_through
+        out.append(Session(day.isoformat(), _at(day, 9, 30), close, ok))
+    return SessionList(out)
