+import sys, os, json, csv
+ROOT = sys.argv[1]; sys.path.insert(0, ROOT)
+from v2_core.fixture import load_research_fixture
+from v2_inputs import market as M
+DATA = os.path.join(ROOT, "research/SOXL_initial_trend_20261023/data")
+daily = json.load(open(os.path.join(DATA, "daily.json"))); adj = list(csv.DictReader(open(os.path.join(DATA, "daily_adjclose.csv"))))
+SRC = {"SOXX": {d: (a, a) for d, a in zip(daily["date"], daily["references"]["SOXX"]["adjClose"]) if a},
+       "SOXL": {d: (c, c) for d, c in zip(daily["funds"]["SOXL"]["ohlcv"]["date"], daily["funds"]["SOXL"]["ohlcv"]["close"])},
+       "SPY": {r["Date"]: (float(r["SPY"]), float(r["SPY"])) for r in adj if r["SPY"]},
+       "IEF": {r["Date"]: (float(r["IEF"]), float(r["IEF"])) for r in adj if r["IEF"]}}
+bad = 0; n = 0
+for d in ["2024-10-01", "2025-01-02", "2025-06-02", "2026-03-02", "2026-07-28", "2026-08-10"]:
+    ref, _ = load_research_fixture(DATA, through=d)
+    mine = M.series_of(d, SRC, "x")
+    a, b = ref.row(d), mine.row(d)
+    same = a == b and ref.soxl_close(d) == mine.soxl_close(d)
+    n += 1; bad += not same
+    print(d, "equal" if same else "DIFF", a if not same else "", b if not same else "")
+print("checked", n, "diff", bad)
+# the same through the pinned snapshot (every symbol cut at PREHISTORY_START, as pinned)
+bad2 = 0
+for d in ["2024-10-01", "2025-01-02", "2025-06-02", "2026-03-02", "2026-07-28", "2026-08-10"]:
+    ref, _ = load_research_fixture(DATA, through=d)
+    through, rows = M.read_snapshot(M.snapshot_bytes(d, SRC))
+    mine = M.series_of(through, rows, "x")
+    same = ref.row(d) == mine.row(d) and ref.soxl_close(d) == mine.soxl_close(d)
+    bad2 += not same
+    print("pinned", d, "equal" if same else "DIFF")
+print("pinned checked 6 diff", bad2)
