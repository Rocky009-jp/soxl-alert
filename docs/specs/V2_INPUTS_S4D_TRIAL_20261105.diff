+            "indicators": {"quote": [{"close": [v[0] for _, v in rows]}], "adjclose": [{"adjclose": [v[1] * scale for _, v in rows]}]}}], "error": None}}
+    return json.dumps(body).encode()
+
+class Provider(object):
