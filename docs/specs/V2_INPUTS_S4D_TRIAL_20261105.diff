+"""S4-D trial, the checks added with the second draft: args, chart_url, git failure, history start, provenance, context."""
+import sys, os, json, tempfile, subprocess, datetime as dt
+ROOT = sys.argv[1]; TMP = sys.argv[2]; sys.path.insert(0, ROOT)
+from v2_core.errors import InputError
+from v2_git_store import Git
+from v2_inputs import load_inputs, chart_url
+from v2_inputs import market as M
+JST = dt.timezone(dt.timedelta(hours=9))
+now = dt.datetime(2026, 7, 22, 7, 40, tzinfo=JST)
+CLOCK = lambda: dt.datetime(2026, 8, 1, tzinfo=dt.timezone.utc)
+REFS = {"market": "v2-market", "ledger": "v2-ledger"}
+calls = []
+def nofetch(*a): calls.append(a); raise AssertionError
+for bad in [dict(now=dt.datetime(2026, 7, 22, 7, 40)), dict(refs={"market": "v2-market"}), dict(refs={"market": "Bad Ref", "ledger": "x"}),
+            dict(fetch=None), dict(clock=1)]:
+    kw = dict(git=None, fetch=nofetch, now=now, refs=REFS, clock=CLOCK); kw.update(bad)
+    try: load_inputs(**kw); print("args: no error", bad)
+    except InputError as e: print("args:", e.code, "context", e.__context__)
+print("fetch calls", len(calls))
+print("url:", chart_url("SOXX", "2010-02-11", "2026-07-22"))
+try: chart_url("AAPL", "2010-02-11", "2026-07-22")
+except InputError as e: print("url bad symbol:", e.code)
+# git failure: a remote path that is not there -> input_git_failed (not git_failed)
+o = tempfile.mkdtemp(prefix="SECRETPATH_", dir=TMP); w = tempfile.mkdtemp(prefix="SECRETPATH_w", dir=TMP)
+subprocess.run(["git", "init", "-q", w], check=True)
+subprocess.run(["git", "remote", "add", "origin", os.path.join(o, "missing.git")], cwd=w, check=True)
+g = Git(w)
+inp = load_inputs(g, nofetch, now, REFS, CLOCK)
+f = inp.failure; print("git gone:", f.code, f.field, f.detail, "context", f.__context__, "prov", inp.provenance)
+print("leak:", "SECRETPATH" in repr(f) + repr(inp.provenance))
+# history start: SOXX lacks 2010-02-11
+def body(symbol, days):
+    ts = [int(dt.datetime.fromisoformat(d + "T13:30:00+00:00").timestamp()) for d in days]
+    return json.dumps({"chart": {"result": [{"meta": {"symbol": symbol}, "timestamp": ts,
+        "indicators": {"quote": [{"close": [10.0] * len(ts)}], "adjclose": [{"adjclose": [10.0] * len(ts)}]}}]}}).encode()
+from v2_inputs.load import _fetch_all
+got, err = _fetch_all(lambda s, a, b: body(s, ["2010-02-12", "2026-07-21"]), "2026-07-22"); print("short:", err.code, err.detail, err.__context__)
+got, err = _fetch_all(lambda s, a, b: body(s, ["2009-01-02", "2010-02-11"]), "2026-07-22"); print("before start dropped:", sorted(got["SOXX"]), err)
+try: M.parse_chart(body("SOXX", ["2026-07-21", "2026-07-21"]), "SOXX")
+except InputError as e: print("duplicate:", e.code, e.__context__)
+try: M.parse_chart(b"\xff", "SOXX")
+except InputError as e: print("not utf8:", e.code, e.__context__)
+try: M.parse_chart("text", "SOXX")
+except InputError as e: print("not bytes:", e.code)
