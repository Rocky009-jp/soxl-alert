+import sys
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "v2_scope_chain"))
+import sc_helpers as C  # noqa: E402
+
+START = "ffa370089cd37fcc76658b4de0f4aedde0a246e0"
+END = None          # not accepted yet; the next stage replaces None with the accepted final commit
+REV = END or "HEAD"
+FIRST_OF_CHAIN = "adfdf765aeca0d01c8f10b596a6fac59d7c1a07e"
+
+
+class FilesChanged(unittest.TestCase):
+    def test_the_whole_chain_has_no_gap_and_this_is_the_only_open_range(self):
+        if C.git("cat-file", "-e", START + "^{commit}").returncode != 0:
+            self.skipTest("the code start commit is not available in this checkout")
+        rows = C.range_tests(REV)
+        self.assertEqual(C.judge_chain(rows, C.is_ancestor, tip=REV, begin=FIRST_OF_CHAIN), [])
+        self.assertEqual([r["path"] for r in rows if r["end"] is None], ["tests/v2_inputs/test_s4d_09_scope.py"])
+        self.assertEqual([r["path"] for r in rows if r["end"] == START], ["tests/v2_git_store/test_s4c_09_scope.py"])
