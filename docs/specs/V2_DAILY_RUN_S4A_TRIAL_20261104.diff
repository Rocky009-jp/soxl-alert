diff --git a/v2_daily_run/run.py b/v2_daily_run/run.py
new file mode 100644
index 0000000..33cf2d1
--- /dev/null
+++ b/v2_daily_run/run.py
@@ -0,0 +1,82 @@
+"""TRIAL. One morning run: read the history, consume every confirmed session up to the latest closed one (one DAILY
+publication each, through the injected store), then evaluate the latest closed session and render the preview text.
+No clock (now is injected), no network, no notification, no retry, no unlock."""
+import datetime
+
+from v2_core.display import render_message
+from v2_core.errors import CoreError
+from v2_core.sessions import SessionList
+from v2_history_ops import ALREADY_APPLIED, NO_COMMIT, PREPARED, prepare_history_day, read_effective
+from v2_history_publish import PUBLISHED, PUBLISHED_THEN_EXTENDED, publish_day
+
+DONE, STALE, STOPPED = "DONE", "STALE", "STOPPED"
+
+
+class RunError(CoreError):
+    pass
+
+
+class RunReport(object):
+    def __init__(self, outcome, target_d, consumed, last_status, message, code=None, history_digest=None):
+        self.outcome, self.target_d, self.consumed = outcome, target_d, tuple(consumed)
+        self.last_status, self.message, self.code, self.history_digest = last_status, message, code, history_digest
+
+    def __repr__(self):
+        return "RunReport(%s, D=%s, consumed=%s, last=%s, code=%s)" % (
+            self.outcome, self.target_d, list(self.consumed), self.last_status, self.code)
+
+
+def _aware(now):
+    if not isinstance(now, datetime.datetime) or now.tzinfo is None or now.utcoffset() is None:
+        raise RunError("run_now_invalid", "now")
+    return now
+
+
+def run_morning(store, now, series, sessions, raw_observations):
+    now = _aware(now)
+    if not isinstance(sessions, SessionList):
+        raise RunError("sessions_invalid", "sessions")
+    closed = [s for s in sessions.sessions if s.close_at <= now]
+    if not closed:
+        raise RunError("run_no_closed_session", "sessions")
+    target = closed[-1]
+    consumed, last = [], None
+    try:
+        history = store.read()
+    except CoreError as e:
+        return RunReport(STOPPED, target.date, consumed, None, None, e.code)
+    view = read_effective(history)
+    start = view.latest_apply_d or view.processing_after
+    for s in sessions.sessions:
+        if s.date <= start or s.date > target.date:
+            continue
+        if not s.confirmed:
+            return RunReport(STALE, target.date, consumed, None, None, "run_session_unconfirmed:" + s.date,
+                             history.digest)
+        try:
+            res = prepare_history_day(history, s.date, series, sessions, raw_observations)
+        except CoreError as e:
+            return RunReport(STOPPED, target.date, consumed, None, None, e.code, history.digest)
+        last = res
+        if res.status == PREPARED:
+            pub = publish_day(history, s.date, series, sessions, raw_observations)
+            try:
+                history = store.publish(pub).history
+            except CoreError as e:
+                if e.code != "store_commit_uncertain":
+                    return RunReport(STOPPED, target.date, consumed, res.status, None, e.code, history.digest)
+                rec = store.reconcile(pub)
+                if rec.status not in (PUBLISHED, PUBLISHED_THEN_EXTENDED):
+                    return RunReport(STOPPED, target.date, consumed, res.status, None,
+                                     "run_publish_" + rec.status.lower(), history.digest)
+                history = store.read()
+            consumed.append(s.date)
+        elif res.status not in (NO_COMMIT, ALREADY_APPLIED):
+            raise AssertionError(res.status)
+    if last is None:            # nothing after the effective head: the latest closed session is already applied
+        try:
+            last = prepare_history_day(history, target.date, series, sessions, raw_observations)
+        except CoreError as e:
+            return RunReport(STOPPED, target.date, consumed, None, None, e.code, history.digest)
+    return RunReport(DONE, target.date, consumed, last.status, render_message(last.core_result), None,
+                     history.digest)
