+import os, sys, tempfile, shutil, time
+from datetime import datetime
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence")): sys.path.insert(0, p)
+import p_helpers as P
+from v2_history_local import HistoryFileStore
+from v2_history_publish import publish_genesis
+from v2_daily_run import run_morning
+D, TZ = P.DATES, P.TZ
+def morning(d):
+    y, m, dd = (int(x) for x in d.split("-")); return datetime(y, m, dd, 18, 0, tzinfo=TZ)
+w = P.World(0); root = tempfile.mkdtemp(dir=os.environ["TMPDIR"]); st = HistoryFileStore(root, writable=True)
+st.initialize(publish_genesis(w.start_after, w.sessions))
+w.ledger += [P.obs("R%d" % i, D[i], 25.0 + (i % 7)) for i in range(1, 38)]
+t=time.time(); r = run_morning(st, morning(D[38]), w.series, w.sessions, w.ledger); print("catch-up", len(r.consumed), "days %.1fs" % (time.time()-t))
+t=time.time(); r = run_morning(st, morning(D[38]), w.series, w.sessions, w.ledger); print("rerun %.2fs" % (time.time()-t), r.last_status)
+print("f", run_morning(st, morning(D[2]), w.series, w.sessions, w.ledger))
+shutil.rmtree(root)
diff --git a/trial_probes/s4a_trial.py b/trial_probes/s4a_trial.py
new file mode 100644
index 0000000..57a9d46
--- /dev/null
+++ b/trial_probes/s4a_trial.py
@@ -0,0 +1,62 @@
+"""S4-A trial scenarios over the trial runner and the real C-3 store in a temp root."""
+import os, sys, tempfile, shutil
+from datetime import datetime, timedelta
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence")):
+    sys.path.insert(0, p)
+import p_helpers as P
+from v2_history_local import HistoryFileStore
+from v2_history_publish import publish_genesis
+from v2_daily_run import run_morning
+D, TZ = P.DATES, P.TZ
+
+def morning(d, hour=7):   # the morning after D's close, before the next open (TZ is US -5)
+    y, m, dd = (int(x) for x in d.split("-"))
+    return datetime(y, m, dd, 16, 0, tzinfo=TZ) + timedelta(hours=hour + 2)   # 16:00+... same evening/night
+
+def fresh(w):
+    root = tempfile.mkdtemp(prefix="s4a_", dir=os.environ.get("TMPDIR"))
+    st = HistoryFileStore(root, writable=True)
+    st.initialize(publish_genesis(w.start_after, w.sessions))
+    return root, st
+
+def show(tag, r):
+    print(tag, r)
+
+# 1 normal: decisions D1, D2 recorded; the run after D3 closes consumes D1, D2 and evaluates D3 (waiting for F&G)
+w = P.World(0); root, st = fresh(w)
+w.ledger += [P.obs("R1", D[1], 30.0), P.obs("R2", D[2], 31.0)]
+r = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); show("1 normal", r)
+print("   message head:", r.message.splitlines()[0]); print("   has F&G-pending line:", "未記録" in r.message)
+# 2 same morning again: nothing new
+r2 = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); show("2 rerun", r2)
+print("   same digest:", r.history_digest == r2.history_digest, "same message:", r.message == r2.message)
+# 3 gap: D3 has no decision, D4 has one; run after D5 closes
+w.ledger += [P.obs("R4", D[4], 25.0)]
+r3 = run_morning(st, morning(D[5]), w.series, w.sessions, w.ledger); show("3 gap", r3)
+print("   gap line:", "途切れ" in r3.message)
+shutil.rmtree(root)
+# 4 stale: D3 unconfirmed (data not final) while now is after D3's close
+w = P.World(0, unconfirmed=(D[3],)); root, st = fresh(w)
+w.ledger += [P.obs("R1", D[1], 30.0), P.obs("R2", D[2], 31.0)]
+r4 = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); show("4 stale", r4)
+shutil.rmtree(root)
+# 5 busy: a leftover write.lock
+w = P.World(0); root, st = fresh(w)
+open(os.path.join(root, "write.lock"), "wb").write(b"x")
+r5 = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); show("5 busy", r5)
+shutil.rmtree(root)
+# 6 decision for the target D already recorded before the run (observed right after close)
+w = P.World(0); root, st = fresh(w)
+w.ledger += [P.obs("R1", D[1], 30.0), P.obs("R2", D[2], 31.0), P.obs("R3", D[3], 22.0, hour=17)]
+r6 = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); show("6 target decided", r6)
+shutil.rmtree(root)
+# 7 a ledger that changed a consumed decision (same record id, other value) -> stop, nothing written
+w = P.World(0); root, st = fresh(w)
+w.ledger += [P.obs("R1", D[1], 30.0)]
+run_morning(st, morning(D[2]), w.series, w.sessions, w.ledger)
+w.ledger[0] = P.obs("R1", D[1], 35.0)
+before = open(os.path.join(root, "history.json"), "rb").read()
+r7 = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); show("7 ledger changed", r7)
+print("   file unchanged:", before == open(os.path.join(root, "history.json"), "rb").read())
+shutil.rmtree(root)
