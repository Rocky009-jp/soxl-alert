+++ b/trial_probes/s4a_trial2.py
@@ -0,0 +1,31 @@
+import os, sys, tempfile, shutil
+from datetime import datetime, timedelta
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence")):
+    sys.path.insert(0, p)
+import p_helpers as P
+from v2_history_local import HistoryFileStore
+from v2_history_publish import publish_genesis
+from v2_daily_run import run_morning
+D, TZ = P.DATES, P.TZ
+def morning(d):
+    y, m, dd = (int(x) for x in d.split("-")); return datetime(y, m, dd, 18, 0, tzinfo=TZ)
+w = P.World(0); root = tempfile.mkdtemp(dir=os.environ["TMPDIR"]); st = HistoryFileStore(root, writable=True)
+st.initialize(publish_genesis(w.start_after, w.sessions))
+w.ledger += [P.obs("R%d" % i, D[i], 30.0 + i) for i in range(1, 4)]
+print("a", run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger))
+r = run_morning(st, morning(D[3]), w.series, w.sessions, w.ledger); print("b rerun after target consumed", r, r.message.splitlines()[0])
+# long absence: decisions for D4..D20 every day, run once after D21 closes
+w.ledger += [P.obs("R%d" % i, D[i], 25.0 + (i % 5)) for i in range(4, 21)]
+r = run_morning(st, morning(D[21]), w.series, w.sessions, w.ledger); print("c catch-up 17 days", r.outcome, len(r.consumed), r.last_status)
+# read-only store
+ro = HistoryFileStore(root, writable=False)
+w.ledger += [P.obs("R21", D[21], 20.0)]
+print("d read-only", run_morning(ro, morning(D[22]), w.series, w.sessions, w.ledger))
+# naive now
+try:
+    run_morning(st, datetime(2026, 3, 5, 18), w.series, w.sessions, w.ledger)
+except Exception as e: print("e naive now", type(e).__name__, e.code)
+# now before genesis boundary's next close
+print("f now earlier than head", run_morning(st, morning(D[2]), w.series, w.sessions, w.ledger))
+shutil.rmtree(root)
