diff --git a/v2_git_store/git.py b/v2_git_store/git.py
new file mode 100644
index 0000000..b7604ff
--- /dev/null
+++ b/v2_git_store/git.py
@@ -0,0 +1,83 @@
+"""TRIAL. The only place that runs git. Output and stderr never leave this module (they may name the remote URL)."""
+import os, subprocess
+from v2_core.errors import CoreError
+
+
+class GitError(CoreError):
+    pass
+
+
+OK, REJECTED, UNCERTAIN = "OK", "REJECTED", "UNCERTAIN"
+_ENV = {"GIT_TERMINAL_PROMPT": "0", "LC_ALL": "C", "GIT_AUTHOR_NAME": "v2-runner", "GIT_AUTHOR_EMAIL": "runner@invalid",
+        "GIT_COMMITTER_NAME": "v2-runner", "GIT_COMMITTER_EMAIL": "runner@invalid", "GIT_CONFIG_NOSYSTEM": "1"}
+
+
+class Git(object):
+    def __init__(self, workdir, remote="origin", timeout=120):
+        self.workdir, self.remote, self.timeout = workdir, remote, timeout
+
+    def run(self, args, data=None, env=None):
+        e = dict(os.environ); e.update(_ENV); e.update(env or {})
+        try:
+            p = subprocess.run(["git", "-c", "core.autocrlf=false", "-c", "commit.gpgsign=false"] + args,
+                               cwd=self.workdir, input=data, capture_output=True, timeout=self.timeout, env=e)
+        except subprocess.TimeoutExpired:
+            return None
+        return p
+
+    def must(self, args, data=None, env=None):
+        p = self.run(args, data, env)
+        if p is None or p.returncode != 0:
+            raise GitError("git_failed", args[0])
+        return p.stdout
+
+    def fetch(self, ref):
+        """Head SHA of refs/heads/<ref> as fetched into a private local ref, or None when the remote has no such ref."""
+        p = self.run(["fetch", "--no-tags", "--quiet", self.remote, "+refs/heads/%s:refs/v2remote/%s" % (ref, ref)])
+        if p is not None and p.returncode == 0:
+            return self.must(["rev-parse", "refs/v2remote/%s" % ref]).decode().strip()
+        q = self.run(["ls-remote", "--heads", self.remote, "refs/heads/" + ref])
+        if q is not None and q.returncode == 0 and not q.stdout.strip():
+            return None
+        raise GitError("git_fetch_failed", ref)
+
+    def blob(self, commit, path):
+        p = self.run(["cat-file", "blob", "%s:%s" % (commit, path)])
+        return None if p is None or p.returncode != 0 else p.stdout
+
+    def names(self, commit):
+        if commit is None:
+            return []
+        return self.must(["ls-tree", "--name-only", commit]).decode().split("\n")[:-1]
+
+    def commit_with(self, parent, path, data, message, when, replace=True):
+        """A new commit: parent's tree with `path` added (it must not be there unless replace) -> SHA."""
+        blob = self.must(["hash-object", "-w", "--stdin"], data).decode().strip()
+        entries = [] if parent is None else self.must(["ls-tree", parent]).decode().split("\n")[:-1]
+        if not replace and any(e.split("\t", 1)[1] == path for e in entries):
+            return None                           # add-only: the name is already in the parent tree
+        entries = [e for e in entries if e.split("\t", 1)[1] != path] + ["100644 blob %s\t%s" % (blob, path)]
+        tree = self.must(["mktree"], ("\n".join(sorted(entries, key=lambda e: e.split("\t", 1)[1])) + "\n").encode()).decode().strip()
+        args = ["commit-tree", tree, "-m", message] + ([] if parent is None else ["-p", parent])
+        stamp = when.isoformat()
+        return self.must(args, env={"GIT_AUTHOR_DATE": stamp, "GIT_COMMITTER_DATE": stamp}).decode().strip()
+
+    def push(self, commit, ref):
+        """Fast-forward only (never forced). OK / REJECTED (the ref moved, or exists when creating) / UNCERTAIN."""
+        p = self.run(["push", "--porcelain", self.remote, "%s:refs/heads/%s" % (commit, ref)])
+        if p is None:
+            return UNCERTAIN
+        for line in p.stdout.decode(errors="replace").splitlines():
+            if line.endswith("refs/heads/%s" % ref) or ("refs/heads/%s\t" % ref) in line:
+                flag = line.split("\t", 1)[0]
+                if flag in ("*", " ", "="):
+                    return OK if p.returncode == 0 else UNCERTAIN
+                if flag == "!":
+                    return REJECTED
+        return UNCERTAIN
+
+    def is_ancestor(self, a, b):
+        p = self.run(["merge-base", "--is-ancestor", a, b])
+        if p is None or p.returncode not in (0, 1):
+            raise GitError("git_failed", "merge-base")
+        return p.returncode == 0
