@@ -0,0 +1,50 @@
+"""N processes, each with its own clone, run the morning job against one bare remote at once; count the sends."""
+import os, sys, subprocess, tempfile, shutil, time, json
+from datetime import datetime, timezone
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence")):
+    sys.path.insert(0, p)
+import p_helpers as P
+D, TZ, TMP = P.DATES, P.TZ, os.environ["TMPDIR"]
+CLOCK = lambda: datetime(2026, 11, 5, tzinfo=timezone.utc)
+def world():
+    w = P.World(0); w.ledger += [P.obs("R%d" % i, D[i], 30.0) for i in range(1, 6)]; return w
+def now():
+    y, m, d = (int(x) for x in D[6].split("-")); return datetime(y, m, d, 18, tzinfo=TZ)
+def sh(*a, cwd=None): subprocess.run(a, cwd=cwd, check=True, capture_output=True)
+def clone(o):
+    from v2_git_store import Git, GitHistoryStore, GitOutbox
+    w = tempfile.mkdtemp(dir=TMP); sh("git", "init", "-q", w); sh("git", "remote", "add", "origin", o, cwd=w)
+    g = Git(w); return g, GitHistoryStore(g, "state", CLOCK), GitOutbox(g, "outbox", tempfile.mkdtemp(dir=TMP), CLOCK)
+if len(sys.argv) > 2:
+    o, sync, i, logf = sys.argv[2:6]
+    from v2_notify import morning_job
+    class S(object):
+        def send(self, t):
+            with open(logf, "a") as f: f.write(json.dumps(t.splitlines()[0]) + "\n")
+            return "SENT"
+    g, h, ob = clone(o); w = world()
+    open(os.path.join(sync, "ready." + i), "w").close()
+    while not os.path.exists(os.path.join(sync, "go")): time.sleep(0.001)
+    r = morning_job(h, ob, S(), now(), w.series, w.sessions, w.ledger)
+    print(r.run_outcome, r.code, r.kind, r.delivery); sys.exit(0)
+from v2_history_publish import publish_genesis
+N, K = int(os.environ.get("N", 3)), int(os.environ.get("K", 10))
+summary, outs_all, applies_bad = {}, {}, 0
+for k in range(K):
+    o = tempfile.mkdtemp(dir=TMP); sh("git", "init", "-q", "--bare", o)
+    g, h, ob = clone(o); w = world(); h.initialize(publish_genesis(w.start_after, w.sessions))
+    print_ = g.push(g.commit_with(None, "README", b"outbox\n", "init", CLOCK()), "outbox")
+    sync = tempfile.mkdtemp(dir=TMP); logf = os.path.join(sync, "sent.log")
+    ps = [subprocess.Popen([sys.executable, "-B", __file__, ROOT, o, sync, str(i), logf], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True) for i in range(N)]
+    while len([x for x in os.listdir(sync) if x.startswith("ready.")]) < N: time.sleep(0.01)
+    open(os.path.join(sync, "go"), "w").close()
+    outs = [p.communicate()[0].strip().splitlines()[-1] for p in ps]
+    for x in outs: outs_all[x] = outs_all.get(x, 0) + 1
+    sent = open(logf).read().splitlines() if os.path.exists(logf) else []
+    kinds = tuple(sorted("halt" if "判定なし" in json.loads(x) else "judgment" for x in sent))
+    summary[kinds] = summary.get(kinds, 0) + 1
+    hist = h.read(); dd = [e["d"] for e in hist.events if e.get("kind") == "APPLY"]
+    applies_bad += len(dd) != len(set(dd))
+print("N=%d K=%d sends:" % (N, K), summary, "dup APPLY rounds:", applies_bad)
+print(" outcomes:", outs_all)
