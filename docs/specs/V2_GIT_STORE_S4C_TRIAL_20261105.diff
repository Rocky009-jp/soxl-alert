@@ -0,0 +1,77 @@
+"""S4-C trial: S4-A + S4-B over the trial git stores, with a local bare repository as the remote."""
+import os, sys, tempfile, shutil, subprocess, time, json
+from datetime import datetime, timedelta, timezone
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence")):
+    sys.path.insert(0, p)
+import p_helpers as P
+from v2_history_publish import publish_genesis
+from v2_git_store import Git, GitHistoryStore, GitOutbox
+from v2_git_store import git as G
+from v2_notify import morning_job, outbox_status
+from v2_daily_run import run_morning
+D, TZ, TMP = P.DATES, P.TZ, os.environ["TMPDIR"]
+CLOCK = lambda: datetime(2026, 11, 5, tzinfo=timezone.utc)
+
+def sh(*a, cwd=None):
+    subprocess.run(a, cwd=cwd, check=True, capture_output=True)
+
+def origin():
+    o = tempfile.mkdtemp(prefix="SECRETPATH_", dir=TMP)
+    sh("git", "init", "-q", "--bare", o); return o
+
+def clone(o):
+    w = tempfile.mkdtemp(dir=TMP); sh("git", "init", "-q", w); sh("git", "remote", "add", "origin", o, cwd=w)
+    m = tempfile.mkdtemp(dir=TMP)
+    g = Git(w); return g, GitHistoryStore(g, "state", CLOCK), GitOutbox(g, "outbox", m, CLOCK)
+
+class Sender(object):
+    def __init__(self): self.sent = []
+    def send(self, t): self.sent.append(t); return "SENT"
+
+def at(d, h=18):
+    y, m, dd = (int(x) for x in d.split("-")); return datetime(y, m, dd, h, tzinfo=TZ)
+
+w = P.World(0); w.ledger += [P.obs("R1", D[1], 30.0), P.obs("R2", D[2], 31.0)]
+o = origin()
+gA, hA, oA = clone(o)
+hA.initialize(publish_genesis(w.start_after, w.sessions))
+# outbox ref needs a first commit: an empty README
+c = gA.commit_with(None, "README", b"outbox\n", "init", CLOCK()); print("outbox init", gA.push(c, "outbox"))
+s = Sender()
+t = time.time(); r = morning_job(hA, oA, s, at(D[3]), w.series, w.sessions, w.ledger)
+print("1 A", r.run_outcome, r.delivery, "%.2fs" % (time.time() - t), "sent", len(s.sent))
+r = morning_job(hA, oA, s, at(D[3]), w.series, w.sessions, w.ledger); print("2 A again", r.delivery, "sent", len(s.sent))
+gB, hB, oB = clone(o)
+r = morning_job(hB, oB, s, at(D[3]), w.series, w.sessions, w.ledger); print("3 B fresh clone", r.run_outcome, r.delivery, "sent", len(s.sent))
+print("  status B", [(e.kind, e.status) for e in outbox_status(oB, D[3])])
+# 4 ref moved between read and publish
+w.ledger += [P.obs("R3", D[3], 22.0), P.obs("R4", D[4], 23.0)]
+class Racing(G.Git):
+    armed = True
+    def push(self, commit, ref):
+        if ref == "state" and Racing.armed:
+            Racing.armed = False
+            run_morning(hB, at(D[4]), w.series, w.sessions, w.ledger)     # B publishes first
+        return G.Git.push(self, commit, ref)
+gR = Racing(gA.workdir); hR = GitHistoryStore(gR, "state", CLOCK)
+print("4 moved", run_morning(hR, at(D[4]), w.series, w.sessions, w.ledger))
+# 5 push uncertain after a real push
+w.ledger += [P.obs("R5", D[5], 24.0)]
+class Lost(G.Git):
+    def push(self, commit, ref):
+        how = G.Git.push(self, commit, ref)
+        return G.UNCERTAIN if ref == "state" and how == G.OK else how
+gL = Lost(gA.workdir); hL = GitHistoryStore(gL, "state", CLOCK)
+r = run_morning(hL, at(D[6]), w.series, w.sessions, w.ledger); print("5 uncertain", r, r.consumed)
+# 6 push uncertain without a push -> NOT_PUBLISHED -> STOPPED
+w.ledger += [P.obs("R6", D[6], 24.0)]
+class Dropped(G.Git):
+    def push(self, commit, ref):
+        return G.UNCERTAIN if ref == "state" else G.Git.push(self, commit, ref)
+hD = GitHistoryStore(Dropped(gA.workdir), "state", CLOCK)
+print("6 dropped", run_morning(hD, at(D[7]), w.series, w.sessions, w.ledger))
