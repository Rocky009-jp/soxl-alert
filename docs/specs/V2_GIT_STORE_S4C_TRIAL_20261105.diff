index 0000000..b105a7e
--- /dev/null
+++ b/v2_git_store/history.py
@@ -0,0 +1,74 @@
+"""TRIAL. history.json on refs/heads/<ref> of the remote, written by fast-forward pushes only."""
+from v2_history_publish import check_publication, history_bytes, read_history_bytes, reconcile_publication
+from v2_history_local import INITIALIZED, HistoryStoreResult
+from v2_persistence.local.errors import LocalStoreError
+from .git import OK, REJECTED, GitError
+
+NAME = "history.json"
+
+
+class GitHistoryStore(object):
+    def __init__(self, git, ref, clock):
+        self._git, self._ref, self._clock = git, ref, clock
+
+    def _head(self):
+        try:
+            return self._git.fetch(self._ref)
+        except GitError:
+            raise LocalStoreError("store_io_error", "history", "read")
+
+    def _bytes(self, head):
+        if head is None:
+            return None
+        data = self._git.blob(head, NAME)
+        if data is None:
+            raise LocalStoreError("store_layout_unsupported", "history", "read")
+        return data
+
+    def read(self):
+        head = self._head()
+        if head is None:
+            raise LocalStoreError("store_uninitialized", "history", "read")
+        history, _ = read_history_bytes(self._bytes(head))
+        return history
+
+    def _write(self, head, pub, current):
+        candidate = check_publication(current, pub)
+        commit = self._git.commit_with(head, NAME, history_bytes(candidate), "v2 history %s" % pub.publication_hash[:12],
+                                       self._clock())
+        how = self._git.push(commit, self._ref)
+        if how == OK:
+            return candidate
+        if how == REJECTED:                       # moved since it was read (another run), or refused by a rule
+            if self._head() != head:
+                raise LocalStoreError("publication_stale", "history", "publish")
+            raise LocalStoreError("store_io_error", "history", "publish")
+        raise LocalStoreError("store_commit_uncertain", "history", "publish")
+
+    def initialize(self, pub):
+        head = self._head()
+        if head is not None:
+            raise LocalStoreError("already_initialized", "store", "read")
+        moved = False
+        try:
+            c = self._write(None, pub, None)
+        except LocalStoreError as e:
+            if e.code != "publication_stale":
+                raise
+            moved = True
+        if moved:                                 # the ref was created by someone else in the meantime
+            raise LocalStoreError("already_initialized", "store", "read")
+        return HistoryStoreResult(INITIALIZED, True, c, "remote", pub.publication_hash)
+
+    def publish(self, pub):
+        head = self._head()
+        if head is None:
+            raise LocalStoreError("store_uninitialized", "history", "read")
+        current = self._bytes(head)
+        read_history_bytes(current)
+        c = self._write(head, pub, current)
+        return HistoryStoreResult("PUBLISHED", True, c, "remote", pub.publication_hash)
+
+    def reconcile(self, pub):
+        """Read the remote again and judge by content only (C-2): no memory of what this process pushed."""
+        return reconcile_publication(self._bytes(self._head()), pub)
diff --git a/v2_git_store/outbox.py b/v2_git_store/outbox.py
new file mode 100644
index 0000000..7c26b9f
--- /dev/null
+++ b/v2_git_store/outbox.py
@@ -0,0 +1,84 @@
+"""TRIAL. The S4-B outbox kept on refs/heads/<ref>: a LocalOutbox over a local mirror directory whose claim and record
+are decided by a fast-forward push of a commit that adds exactly that file. Only public methods are overridden."""
+import os, shutil
+from v2_notify import DAMAGED, LocalOutbox, NotifyError, OutboxEntry
+from .git import OK, REJECTED, GitError
+
+_TRIES = 4
+
+
+class GitOutbox(LocalOutbox):
+    def __init__(self, git, ref, mirror, clock):
+        super().__init__(mirror, "file_sync_only")
+        self._git, self._ref, self._mirror, self._clock, self._headsha = git, ref, mirror, clock, None
+
+    def _refresh(self):
+        try:
+            head = self._git.fetch(self._ref)
+            for n in os.listdir(self._mirror):
+                os.unlink(os.path.join(self._mirror, n))
+            for n in self._git.names(head):
+                data = self._git.blob(head, n)
+                if data is None:
+                    raise GitError("git_failed", "cat-file")
+                with open(os.path.join(self._mirror, n), "wb") as f:
+                    f.write(data)
+        except (GitError, OSError):
+            raise NotifyError("outbox_io_error", "outbox")
+        self._headsha = head
+
+    def load(self, d, kind, resend_request_id=None):
+        failed = False
+        try:
+            self._refresh()
+        except NotifyError:
+            failed = True
+        if failed:                                # the job reads status without a handler: never raise, never send
+            return OutboxEntry(kind, d, resend_request_id, DAMAGED), None
+        return super().load(d, kind, resend_request_id)
+
+    def resend_ids(self, d, kind):
+        self._refresh()
+        return super().resend_ids(d, kind)
+
+    def _decide(self, make):
+        """make() creates one local file through LocalOutbox and returns its value (None/False when it is present).
+        The file is found as the one name the call added to the mirror (no private name of LocalOutbox is used)."""
+        for _ in range(_TRIES):
+            self._refresh()
+            before = set(os.listdir(self._mirror))
+            value = make()
+            if not value:
+                return value
+            added = set(os.listdir(self._mirror)) - before
+            if len(added) != 1:
+                raise NotifyError("outbox_io_error", "outbox")
+            name = added.pop()
+            with open(os.path.join(self._mirror, name), "rb") as f:
+                data = f.read()
+            try:
+                commit = self._git.commit_with(self._headsha, name, data, "v2 outbox " + name, self._clock(),
+                                               replace=False)
+                if commit is None:                # the remote has the name although the mirror did not: not ours
+                    return None if isinstance(value, str) else False
+                how = self._git.push(commit, self._ref)
+            except GitError:
+                how = None
+            if how == OK:
+                return value
+            parent = self._headsha
+            self._refresh()                       # rejected or uncertain: what does the remote say now?
+            path = os.path.join(self._mirror, name)
+            if os.path.exists(path):
+                with open(path, "rb") as f:
+                    same = f.read() == data
+                return value if same else (None if isinstance(value, str) else False)
+            if how == REJECTED and self._headsha == parent:   # not there, the ref did not move: a rule refused it
+                raise NotifyError("outbox_io_error", "outbox")
+        raise NotifyError("outbox_io_error", "outbox")
+
+    def claim(self, notice, now, resend_request_id=None, resend_of=None):
+        return self._decide(lambda: LocalOutbox.claim(self, notice, now, resend_request_id, resend_of))
+
+    def record(self, d, kind, claim_id, status, now, resend_request_id=None):
+        return self._decide(lambda: LocalOutbox.record(self, d, kind, claim_id, status, now, resend_request_id))
