@@ -0,0 +1,83 @@
+"""S4-B trial scenarios: real S4-A + real C-3 store + trial outbox + fake sender."""
+import os, sys, tempfile, shutil
+from datetime import datetime, timedelta
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence"), os.path.join(ROOT, "tests", "v2_history")):
+    sys.path.insert(0, p)
+import p_helpers as P
+from v2_history_local import HistoryFileStore
+from v2_history_publish import publish_genesis
+from v2_notify import LocalOutbox, morning_job, resend
+D, TZ = P.DATES, P.TZ
+TMP = os.environ["TMPDIR"]
+
+class Sender(object):
+    def __init__(self, mode="SENT"):
+        self.mode, self.sent = mode, []
+    def send(self, text):
+        self.sent.append(text)
+        if self.mode == "RAISE":
+            raise TimeoutError("timeout")
+        return self.mode
+
+def at(d, h=18, m=0):
+    y, mo, dd = (int(x) for x in d.split("-")); return datetime(y, mo, dd, h, m, tzinfo=TZ)
+
+def setup(unconfirmed=()):
+    w = P.World(0, unconfirmed=unconfirmed)
+    hroot, oroot = tempfile.mkdtemp(dir=TMP), tempfile.mkdtemp(dir=TMP)
+    st = HistoryFileStore(hroot, writable=True); st.initialize(publish_genesis(w.start_after, w.sessions))
+    return w, st, LocalOutbox(oroot), hroot, oroot
+
+def job(w, st, ob, snd, now):
+    r, n, s = morning_job(st, ob, snd, now, w.series, w.sessions, w.ledger)
+    return (r.outcome if r else None), n.kind, s
+
+# 1 normal then the same morning twice more: one send
+w, st, ob, h, o = setup(); s = Sender()
+w.ledger += [P.obs("R1", D[1], 30.0), P.obs("R2", D[2], 31.0)]
+print("1a", job(w, st, ob, s, at(D[3])), "1b", job(w, st, ob, s, at(D[3])), "1c", job(w, st, ob, s, at(D[3])), "sends", len(s.sent))
+print("   files", sorted(os.listdir(o)))
+# 2 STALE (D4 unconfirmed), D2 missing -> halt notice lists D2; later D4 confirmed -> judgment for D4 still sent
+w, st, ob, h, o = setup(unconfirmed=(D[4],)); s = Sender()
+w.ledger += [P.obs("R1", D[1], 30.0), P.obs("R3", D[3], 31.0)]
+r = job(w, st, ob, s, at(D[4])); print("2a", r, "D2 in text:", D[2] in s.sent[-1])
+w.sessions = P.make_sessions()      # D4 confirmed now
+r = job(w, st, ob, s, at(D[4], 19)); print("2b", r, "sends", len(s.sent))
+r = job(w, st, ob, s, at(D[4], 20)); print("2c rerun", r, "sends", len(s.sent))
+# 3 judgment sent, then a later run of the same D stops (store busy) -> no halt notice
+open(os.path.join(h, "write.lock"), "wb").write(b"x")
+r = job(w, st, ob, s, at(D[4], 21)); print("3", r, "sends", len(s.sent))
+os.unlink(os.path.join(h, "write.lock"))
+# 4 sender times out -> UNKNOWN, rerun never sends, resend once by id, same id again refused/skipped
+w, st, ob, h, o = setup(); s = Sender("RAISE")
+w.ledger += [P.obs("R1", D[1], 30.0)]
+print("4a", job(w, st, ob, s, at(D[2])), "4b", job(w, st, ob, s, at(D[2])), "sends", len(s.sent))
+s.mode = "SENT"
+print("4c resend", resend(ob, s, D[2], "morning", "req1", at(D[2], 22)), "4d same id", resend(ob, s, D[2], "morning", "req1", at(D[2], 23)),
+      "4e new id", resend(ob, s, D[2], "morning", "req2", at(D[2], 23)), "sends", len(s.sent))
+# 5 NOT_STARTED -> NOT_SENT, resend allowed
+w, st, ob, h, o = setup(); s = Sender("NOT_STARTED"); w.ledger += [P.obs("R1", D[1], 30.0)]
+print("5", job(w, st, ob, s, at(D[2])), ob.state(D[2], "morning")[0])
+# 6 run after the next open with no decision -> line about the passed open
+w, st, ob, h, o = setup(); s = Sender()
+y = D[3]; nxt = w.sessions.next(y).open_at
+r = job(w, st, ob, s, nxt + timedelta(minutes=5)); print("6", r, "passed-open line:", "寄付き" in s.sent[-1].splitlines()[1])
+# 7 RunError (naive now is not possible through the job; use no closed session) -> error notice once per UTC day
+w, st, ob, h, o = setup(); s = Sender()
+early = at(P.DATES[0], 1)
+try:
+    print("7a", job(w, st, ob, s, early - timedelta(days=30)), "7b", job(w, st, ob, s, early - timedelta(days=30)), "sends", len(s.sent))
+except Exception as e:
+    print("7 raised", type(e).__name__, e)
+# 8 program error inside run_morning -> error notice sent, then the exception goes on
+class BadSeries(object):
+    def through(self, d): raise ZeroDivisionError("boom /secret/path")
+w, st, ob, h, o = setup(); s = Sender(); w.ledger += [P.obs("R1", D[1], 30.0)]
+try:
+    morning_job(st, ob, s, at(D[2]), BadSeries(), w.sessions, w.ledger)
+except ZeroDivisionError:
+    print("8 raised after notice; sent", len(s.sent), "no path in text:", "/secret" not in s.sent[-1])
+# 9 first APPLY after GENESIS with a skipped day (gap False) is listed in a DONE notice
+w, st, ob, h, o = setup(); s = Sender(); w.ledger += [P.obs("R2", D[2], 30.0)]
+r = job(w, st, ob, s, at(D[3])); print("9", r, "D1 listed:", D[1] in s.sent[-1])
