@@ -0,0 +1,48 @@
+"""TRIAL. The notice: kind (MORNING = a judgment, HALT = no judgment, ERROR = no report), its key date and its text."""
+import hashlib
+from v2_daily_run import DONE
+
+MORNING, HALT, ERROR = "morning", "halt", "error"
+_UNSURE = ("run_publish_uncertain", "run_publish_conflict")
+
+
+class Notice(object):
+    def __init__(self, kind, d, text, outcome, code):
+        self.kind, self.d, self.text, self.outcome, self.code = kind, d, text, outcome, code
+        self.sha256 = hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def _missing_lines(report, only_without_gap):
+    out = []
+    for day in report.consumed:
+        if day.skipped_sessions and not (only_without_gap and day.gap):
+            out.append("  %s の前に、F&Gの記録が無いセッションがありました: %s"
+                       % (day.d, "、".join(day.skipped_sessions)))
+    return (["【F&Gの記録の欠け】"] + out) if out else []
+
+
+def compose_notice(report, sessions, now):
+    head = "【SOXL日次】対象D=%s" % report.target_d
+    if report.outcome == DONE:
+        lines = [head]
+        nxt = sessions.next(report.target_d)
+        if report.target_status == "NO_COMMIT" and nxt is not None and now >= nxt.open_at:
+            lines.append("※この実行は対象Dの次の寄付き（%s）の後です。下の分岐表の寄付きは過ぎています。"
+                         % nxt.open_at.isoformat())
+        lines += _missing_lines(report, only_without_gap=True)
+        lines.append(report.message)
+        return Notice(MORNING, report.target_d, "\n".join(lines), report.outcome, None)
+    lines = [head + " ／判定なし"] + _missing_lines(report, only_without_gap=False)
+    if report.code in _UNSURE:
+        lines.append("※最後の日の保存は確認できていません。")
+    if report.code == "target_not_after_boundary":
+        lines.append("※対象Dは記録の開始境界の日です。次のセッションから処理します（異常ではありません）。")
+    lines.append(report.message)
+    return Notice(HALT, report.target_d, "\n".join(lines), report.outcome, report.code)
+
+
+def compose_error_notice(now, code, type_name):
+    d = now.date().isoformat()
+    text = ("【SOXL日次】判定なし（実行の誤り）\n  今朝は結果を出していません。条件未達ではありません。\n"
+            "  理由: %s%s" % (code, "" if type_name is None else "（%s）" % type_name))
+    return Notice(ERROR, d, text, None, code)
