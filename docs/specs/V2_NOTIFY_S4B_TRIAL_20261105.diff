+"""N processes run the trial morning job at once on one history root and one outbox root; count the sends."""
+import os, sys, subprocess, tempfile, shutil, time, json
+from datetime import datetime
+ROOT = sys.argv[1]
+for p in (ROOT, os.path.join(ROOT, "tests", "v2_persistence")):
+    sys.path.insert(0, p)
+import p_helpers as P
+D, TZ = P.DATES, P.TZ
+def now():
+    y, m, d = (int(x) for x in D[6].split("-")); return datetime(y, m, d, 18, tzinfo=TZ)
+def world():
+    w = P.World(0); w.ledger += [P.obs("R%d" % i, D[i], 30.0) for i in range(1, 6)]; return w
+if len(sys.argv) > 2:
+    h, o, sync, i, logf = sys.argv[2:7]
+    from v2_history_local import HistoryFileStore
+    from v2_notify import LocalOutbox, morning_job
+    class S(object):
+        def send(self, text):
+            with open(logf, "a") as f: f.write(json.dumps(text.splitlines()[0]) + "\n")
+            return "SENT"
+    w = world()
+    open(os.path.join(sync, "ready." + i), "w").close()
+    while not os.path.exists(os.path.join(sync, "go")): time.sleep(0.001)
+    r, n, s = morning_job(HistoryFileStore(h, writable=True), LocalOutbox(o), S(), now(), w.series, w.sessions, w.ledger)
+    print(r.outcome, r.code, n.kind, s); sys.exit(0)
+from v2_history_local import HistoryFileStore
+from v2_history_publish import publish_genesis
+N, K, TMP = int(os.environ.get("N", 4)), int(os.environ.get("K", 20)), os.environ["TMPDIR"]
+summary = {}
+for k in range(K):
+    h, o, sync = (tempfile.mkdtemp(dir=TMP) for _ in range(3)); logf = os.path.join(sync, "sent.log")
+    w = world(); HistoryFileStore(h, writable=True).initialize(publish_genesis(w.start_after, w.sessions))
+    ps = [subprocess.Popen([sys.executable, "-B", __file__, ROOT, h, o, sync, str(i), logf], stdout=subprocess.PIPE, text=True) for i in range(N)]
+    while len([x for x in os.listdir(sync) if x.startswith("ready.")]) < N: time.sleep(0.01)
+    open(os.path.join(sync, "go"), "w").close()
+    outs = [p.communicate()[0].strip() for p in ps]
+    sent = open(logf).read().splitlines() if os.path.exists(logf) else []
+    key = (len(sent), tuple(sorted("judgment" if "判定なし" not in json.loads(x) else "halt" for x in sent)))
+    summary[key] = summary.get(key, 0) + 1
+    for d in (h, o, sync): shutil.rmtree(d)
+print("N=%d K=%d" % (N, K), summary)
