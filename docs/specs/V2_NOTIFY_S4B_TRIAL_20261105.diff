index 0000000..2e65c76
--- /dev/null
+++ b/v2_notify/job.py
@@ -0,0 +1,59 @@
+"""TRIAL. The morning job: run S4-A, compose one notice, take the send right, send through the injected sender, record.
+The sender returns "SENT" or "NOT_STARTED"; anything else (another value, an exception) is UNKNOWN. Never resends."""
+from v2_core.errors import CoreError
+from v2_daily_run import RunError, run_morning
+from .compose import ERROR, HALT, MORNING, Notice, compose_error_notice, compose_notice
+from .outbox import NONE, NOT_SENT, SENT, UNKNOWN
+
+
+def _send(sender, text):
+    try:
+        r = sender.send(text)
+    except Exception:
+        return UNKNOWN
+    return SENT if r == "SENT" else NOT_SENT if r == "NOT_STARTED" else UNKNOWN
+
+
+def _deliver(outbox, sender, notice, now):
+    if notice.kind != MORNING and notice.kind != ERROR:
+        st, _c = outbox.state(notice.d, MORNING)
+        if st != NONE:
+            return "SKIPPED_JUDGMENT_EXISTS"
+    claim_id = outbox.claim(notice, now)
+    if claim_id is None:
+        return "SKIPPED_CLAIMED"
+    status = _send(sender, notice.text)
+    outbox.record(notice.d, notice.kind, claim_id, status, now)
+    return status
+
+
+def morning_job(store, outbox, sender, now, series, sessions, raw):
+    err, exc = None, None
+    try:
+        report = run_morning(store, now, series, sessions, raw)
+    except RunError as e:
+        report, err = None, (e.code, None)
+    except Exception as e:                      # a program error: notify without the text, then raise it again
+        report, err, exc = None, ("unexpected_error", type(e).__name__), e
+    notice = compose_notice(report, sessions, now) if report is not None else compose_error_notice(now, *err)
+    status = _deliver(outbox, sender, notice, now)
+    if exc is not None:
+        raise exc
+    return report, notice, status
+
+
+def resend(outbox, sender, d, kind, resend_id, now):
+    st, claim = outbox.state(d, kind)
+    if claim is None or st == SENT:
+        return "REFUSED_" + st
+    for rid in outbox.resend_ids(d, kind):
+        if outbox.state(d, kind, rid)[0] == SENT:
+            return "REFUSED_ALREADY_RESENT"
+    n = Notice(kind, d, "【再送】元の通知の送信を確認できなかったため、同じ内容を送ります。\n" + claim["text"],
+               claim["outcome"], claim["code"])
+    cid = outbox.claim(n, now, resend_id, claim["claim_id"])
+    if cid is None:
+        return "SKIPPED_CLAIMED"
+    status = _send(sender, n.text)
+    outbox.record(d, kind, cid, status, now, resend_id)
+    return status
diff --git a/v2_notify/outbox.py b/v2_notify/outbox.py
new file mode 100644
index 0000000..124df49
--- /dev/null
+++ b/v2_notify/outbox.py
@@ -0,0 +1,93 @@
+"""TRIAL. A local outbox in one explicit directory. A claim and a result are created exclusively (never replaced)."""
+import json, os, secrets
+from v2_core.errors import CoreError
+from v2_persistence.local.fsops import FileOps
+
+NONE, CLAIMED, SENT, NOT_SENT, UNKNOWN, DAMAGED = "NONE", "CLAIMED", "SENT", "NOT_SENT", "UNKNOWN", "DAMAGED"
+
+
+class OutboxError(CoreError):
+    pass
+
+
+def _cj(x):
+    return json.dumps(x, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
+
+
+class LocalOutbox(object):
+    def __init__(self, root, _ops=None):
+        self._root, self._ops = root, _ops or FileOps()
+
+    def _path(self, name):
+        return os.path.join(self._root, name)
+
+    def _create(self, name, obj):
+        """True if this call created the file; False if something is already there."""
+        try:
+            fd = self._ops.create_exclusive(self._path(name))
+        except FileExistsError:
+            return False
+        except OSError:
+            err = OutboxError("outbox_io_error", "outbox")
+        else:
+            err = None
+        if err is not None:
+            raise err
+        w = self._ops.open_writer(fd)
+        try:
+            data = _cj(obj)
+            n = 0
+            while n < len(data):
+                n += self._ops.write(w, data[n:])
+            self._ops.flush(w)
+            self._ops.fsync_file(w)
+        finally:
+            self._ops.close(w)
+        self._ops.fsync_dir(self._root)
+        return True
+
+    def _read(self, name):
+        try:
+            data, _st = self._ops.read_file(self._path(name))
+        except FileNotFoundError:
+            return None
+        try:
+            return json.loads(data.decode("utf-8"))
+        except ValueError:
+            return DAMAGED
+
+    @staticmethod
+    def _base(d, kind, resend_id=None):
+        return "%s-%s" % (d, kind) + ("" if resend_id is None else ".resend-%s" % resend_id)
+
+    def state(self, d, kind, resend_id=None):
+        base = self._base(d, kind, resend_id)
+        claim = self._read(base + ".claim.json")
+        if claim is None:
+            return NONE, None
+        if claim is DAMAGED:
+            return DAMAGED, None
+        result = self._read(base + ".result.json")
+        if result is None:
+            return UNKNOWN, claim                 # an intent without a result: maybe sent
+        if result is DAMAGED or result.get("claim_id") != claim["claim_id"]:
+            return DAMAGED, claim
+        return result["status"], claim
+
+    def resend_ids(self, d, kind):
+        pre, out = self._base(d, kind) + ".resend-", []
+        for n in sorted(self._ops.listdir(self._root)):
+            if n.startswith(pre) and n.endswith(".claim.json"):
+                out.append(n[len(pre):-len(".claim.json")])
+        return out
+
+    def claim(self, notice, now, resend_id=None, resend_of=None):
+        claim_id = secrets.token_hex(16)
+        body = {"kind": notice.kind, "d": notice.d, "claim_id": claim_id, "text": notice.text,
+                "text_sha256": notice.sha256, "outcome": notice.outcome, "code": notice.code,
+                "claimed_at": now.isoformat(), "resend_of": resend_of}
+        return claim_id if self._create(self._base(notice.d, notice.kind, resend_id) + ".claim.json", body) else None
+
+    def record(self, d, kind, claim_id, status, now, resend_id=None):
+        return self._create(self._base(d, kind, resend_id) + ".result.json",
+                            {"claim_id": claim_id, "status": status, "recorded_at": now.isoformat()})
