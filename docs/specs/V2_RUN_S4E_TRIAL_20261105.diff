new file mode 100644
index 0000000..2aedcc5
--- /dev/null
+++ b/v2_run/check.py
@@ -0,0 +1,83 @@
+"""TRIAL. check-source: the facts of the chart responses that the dry run must record before the live run (S4-D
+handoffs: the design review P-03, the receipt P-02, the re-review R-02). Counts and dates only; nothing is written."""
+import csv
+import datetime as dt
+import json
+import os
+
+from v2_inputs import CALENDAR_START, SYMBOLS
+from v2_inputs.xnys import ny_offset, session_days
+
+RESEARCH = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+                        "research", "SOXL_initial_trend_20261023", "data")
+
+
+def _ny(stamp):
+    utc = dt.datetime.fromtimestamp(stamp, dt.timezone.utc)
+    local = utc + ny_offset(utc.date())
+    return local.date().isoformat(), local.strftime("%H:%M")
+
+
+def research_dates():
+    """{symbol: set of dates} of the research data (SOXX and SOXL from daily.json, SPY and IEF from the csv)."""
+    with open(os.path.join(RESEARCH, "daily.json"), encoding="utf-8") as f:
+        daily = json.load(f)
+    out = {"SOXX": {d for d, a in zip(daily["date"], daily["references"]["SOXX"]["adjClose"]) if a},
+           "SOXL": set(daily["funds"]["SOXL"]["ohlcv"]["date"])}
+    with open(os.path.join(RESEARCH, "daily_adjclose.csv"), encoding="utf-8") as f:
+        rows = list(csv.DictReader(f))
+    for s in ("SPY", "IEF"):
+        out[s] = {r["Date"] for r in rows if r[s]}
+    return out
+
+
+def inspect(data, symbol, target, table, known, pinned=None, through=None):
+    """A dict of facts of one response. target: the target D of now; table: the table dates up to target."""
+    facts = {"symbol": symbol}
+    try:
+        res = json.loads(data.decode("utf-8"))["chart"]["result"][0]
+        ts = res["timestamp"]
+        close = res["indicators"]["quote"][0]["close"]
+        adj = res["indicators"]["adjclose"][0]["adjclose"]
+        facts["meta_symbol_ok"] = res["meta"]["symbol"] == symbol
+    except Exception as e:                      # the type name only
+        facts["shape"] = "invalid (%s)" % type(e).__name__
+        return facts
+    facts["shape"] = "ok" if len(ts) == len(close) == len(adj) else "lengths differ"
+    days, times, nulls, dup = {}, {}, [], []
+    for t, c, a in zip(ts, close, adj):
+        d, hm = _ny(t)
+        times[hm] = times.get(hm, 0) + 1
+        if d in days:
+            dup.append(d)
+        days[d] = (c, a)
+        if c is None or a is None:
+            nulls.append(d)
+    have = {d for d, v in days.items() if v[0] is not None and v[1] is not None}
+    facts["rows"] = len(ts)
+    facts["first"], facts["last"] = (min(days), max(days)) if days else (None, None)
+    facts["times_ny"] = ", ".join("%s×%d" % (k, v) for k, v in sorted(times.items(), key=lambda x: -x[1])[:4])
+    facts["duplicate_dates"] = ", ".join(sorted(set(dup))[-5:]) or "-"
+    facts["target_rows"] = sum(1 for t in ts if _ny(t)[0] == target)
+    facts["table_days_missing_or_null"] = len([d for d in table if d not in have])
+    facts["table_days_missing_examples"] = ", ".join([d for d in table if d not in have][:5]) or "-"
+    facts["null_rows"] = len(nulls)
+    before = {d for d in have if d < CALENDAR_START.isoformat()}
+    ref = {d for d in known.get(symbol, set()) if d < CALENDAR_START.isoformat()}
+    lo = min(ref) if ref else None
+    facts["pre2026_only_in_response"] = len({d for d in before if lo and d >= lo} - ref)
+    facts["pre2026_only_in_research"] = len(ref - before)
+    rets = []
+    if pinned is not None and through is not None:      # P-03(d): was a provisional value pinned? (close never revises)
+        last = days.get(through)
+        facts["pin_last_close_changed"] = "no row" if last is None else (last[0] != pinned.get(through, (None,))[0])
+        facts["pin_older_close_changed"] = sum(1 for d, v in pinned.items() if d < through and d in days and days[d][0] != v[0])
+        common = sorted(d for d in pinned if d in have and d <= through)
+        for a_, b_ in zip(common, common[1:]):                # daily returns of adjclose, robust to a rescaled history
+            rets.append(abs(days[b_][1] / days[a_][1] - pinned[b_][1] / pinned[a_][1]))
+        facts["pin_adj_return_maxdiff"] = "%.2e" % max(rets) if rets else "-"
+    return facts
+
+
+def table_dates(target):
+    return [d.isoformat() for d in session_days() if d.isoformat() <= target]
diff --git a/v2_run/entry.py b/v2_run/entry.py
new file mode 100644
index 0000000..1d85b03
--- /dev/null
+++ b/v2_run/entry.py
@@ -0,0 +1,218 @@
+"""TRIAL. python -m v2_run <command> --mode dry|live --workdir <checkout of the private repository> [...]
+
+Commands: morning (the scheduled run), status (the outbox of one date), resend (a manual resend), init (a new genesis
+and outbox on the refs of the mode), check-source (the facts of the chart responses, nothing written).
+The entry is the only place that reads the clock, the environment (the webhook secret and the summary file) and opens
+HTTP. Everything is decided once in Setup and the same objects are passed on (R2-P01). The record of a run (the Actions
+summary) has codes, dates, digests, counts and times: never a path, a URL, a secret or an exception text."""
+import argparse
+import datetime as dt
+import json
+import os
+import re
+import shutil
+import tempfile
+import time
+import urllib.request
+
+from v2_core.errors import CoreError
+from v2_git_store import Git, GitHistoryStore, GitOutbox
+from v2_history_publish import publish_genesis
+from v2_inputs import build_sessions, guarded_store, load_inputs, SYMBOLS
+from v2_notify import ERROR, HALT, KINDS, MORNING, NONE, SENT, SKIPPED_CLAIMED, SKIPPED_JUDGMENT_EXISTS, morning_job, outbox_status, resend
+
+from .web import DiscordSender, DrySender, live_text, make_fetch
+
+MODES = {
+    "dry": {"state": "v2-dry-state", "outbox": "v2-dry-outbox", "market": "v2-dry-market", "ledger": "v2-ledger"},
+    "live": {"state": "v2-state", "outbox": "v2-outbox", "market": "v2-market", "ledger": "v2-ledger"},
+}
+SECRET_NAME = "V2_DISCORD_WEBHOOK_URL"
+OK_DELIVERIES = (SENT, SKIPPED_CLAIMED, SKIPPED_JUDGMENT_EXISTS)
+REFUSED_JUDGMENT_EXISTS = "REFUSED_JUDGMENT_EXISTS"
+_SHA = re.compile(r"[0-9a-f]{40}")
+_DATE = re.compile(r"\d{4}-\d{2}-\d{2}")
+
+
+def utc_now():
+    return dt.datetime.now(dt.timezone.utc)
+
+
+class Setup(object):
+    """Everything of one run, decided once (R2-P01): mode, now, Git, refs, store, outbox, sender, fetch."""
+
+    def __init__(self, mode, workdir, env, urlopen, now_fn, scratch):
+        self.mode, self.refs, self.clock = mode, MODES[mode], now_fn
+        self.now = now_fn()
+        self.git = Git(workdir)
+        self.store = GitHistoryStore(self.git, self.refs["state"], now_fn)
+        self.outbox = GitOutbox(self.git, self.refs["outbox"], scratch, now_fn)
+        self.sender = DrySender() if mode == "dry" else DiscordSender(env.get(SECRET_NAME), urlopen)
+        self.fetch = make_fetch(urlopen)
+
+
+class Record(object):
+    def __init__(self):
+        self.lines = []
+
+    def add(self, key, value):
+        self.lines.append("- %s: %s" % (key, value))
+
+    def block(self, title, text):
+        self.lines += ["", "#### " + title, "", "```", text.replace("```", "'''"), "```"]
+
+
+def _git_version(git):
+    proc = git.run(["--version"])
+    m = re.search(r"\d+\.\d+(\.\d+)?", proc.stdout.decode("ascii", "replace")) if proc is not None else None
+    return m.group(0) if m else "unknown"
+
+
+def _outbox_files(s):
+    head = s.git.fetch(s.refs["outbox"])
+    return 0 if head is None else len(s.git.tree(head))
+
+
+def cmd_morning(s, rec):
+    t0 = time.monotonic()
+    inputs, raised = None, None
+    try:
+        inputs = load_inputs(s.git, s.fetch, s.now, {"market": s.refs["market"], "ledger": s.refs["ledger"]}, s.clock)
+    except CoreError as e:                      # input_args_invalid / input_calendar_ended: still one notice (ERROR)
+        raised = e
+    t1 = time.monotonic()
+    if inputs is None:
+        job = morning_job(s.store, s.outbox, s.sender, s.now, None, None, [])
+    else:
+        job = morning_job(guarded_store(s.store, inputs.failure), s.outbox, s.sender, s.now, inputs.series,
+                          inputs.sessions, inputs.raw_observations)
+    t2 = time.monotonic()
+    if raised is not None:
+        rec.add("inputs_raised", "%s（%s）" % (raised.code, getattr(raised, "field", None)))
+    elif inputs.failure is not None:
+        f = inputs.failure
+        rec.add("inputs_failure", "%s（%s）%s" % (f.code, f.field, "" if not f.detail else " " + f.detail))
+    if inputs is not None:
+        for k in sorted(inputs.provenance):
+            rec.add("provenance." + k, inputs.provenance[k])
+    rec.add("run_outcome", job.run_outcome)
+    rec.add("key", "%s-%s" % (job.d, job.kind))
+    rec.add("delivery", job.delivery)
+    rec.add("send_status", job.send_status)
+    rec.add("existing_status", job.existing_status)
+    rec.add("code", job.code)
+    if job.report is not None:
+        rec.add("consumed", " ".join(d.d for d in job.report.consumed) or "-")
+        rec.add("history_digest", (job.report.history_digest or "-")[:12])
+    files = _outbox_files(s)
+    t3 = time.monotonic()
+    s.outbox.load(job.d, job.kind)              # one read of the outbox (S4-C handoff 3)
+    t4 = time.monotonic()
+    rec.add("seconds.load_inputs", "%.2f" % (t1 - t0))
+    rec.add("seconds.morning_job", "%.2f" % (t2 - t1))
+    rec.add("seconds.outbox_load", "%.2f" % (t4 - t3))
+    rec.add("outbox_files", files)
+    if s.mode == "dry" and s.sender.texts:
+        rec.block("text (dry: not sent)", s.sender.texts[-1])
+    return 0 if (raised is None and job.delivery in OK_DELIVERIES) else 1
+
+
+def cmd_status(s, rec, d):
+    for e in outbox_status(s.outbox, d):
+        rec.add("%s-%s%s" % (e.d, e.kind, "" if e.resend_request_id is None else "/" + e.resend_request_id),
+                "%s %s" % (e.status, e.recorded_at or e.claimed_at or ""))
+    return 0
+
+
+def cmd_resend(s, rec, d, kind, rid):
+    if kind in (HALT, ERROR) and s.outbox.status(d, MORNING).status != NONE:     # S4-B review P-02
+        rec.add("delivery", REFUSED_JUDGMENT_EXISTS)
+        return 1
+    r = resend(s.outbox, s.sender, d, kind, rid, s.now)
+    rec.add("delivery", r.delivery)
+    rec.add("send_status", r.send_status)
+    rec.add("original_status", r.original_status)
+    return 0 if r.delivery == SENT else 1
+
+
+def cmd_init(s, rec, start_after):
+    sessions = build_sessions(s.now, start_after)     # the boundary is confirmed by the table once it has closed
+    closed = [x.date for x in sessions.sessions if x.close_at <= s.now]
+    if start_after not in closed:
+        rec.add("refused", "start_after_not_a_closed_session")
+        return 1
+    result = s.store.initialize(publish_genesis(start_after, sessions))
+    rec.add("state", getattr(result, "status", result))
+    rec.add("outbox", s.outbox.initialize())
+    return 0
+
+
+def cmd_check_source(s, rec):
+    from .check import inspect, research_dates, table_dates
+    from v2_inputs import PREHISTORY_START
+    closed = [x.date for x in build_sessions(s.now, None).sessions if x.close_at <= s.now]
+    target = closed[-1] if closed else None
+    rec.add("target_d", target)
+    table, known = table_dates(target) if target else [], research_dates()
+    from v2_inputs import MarketPin
+    _head, through, pinned, _digest = MarketPin(s.git, s.refs["market"], s.clock).read()
+    rec.add("pin_through", through)
+    end = (s.now + dt.timedelta(days=1)).date().isoformat()
+    worst = 0
+    for symbol in SYMBOLS:
+        try:
+            data = s.fetch(symbol, PREHISTORY_START, end)
+        except Exception as e:
+            rec.add(symbol + ".fetch", "failed (%s)" % type(e).__name__)
+            worst = 1
+            continue
+        for k, v in inspect(data, symbol, target, table, known, (pinned or {}).get(symbol), through).items():
+            if k != "symbol":
+                rec.add("%s.%s" % (symbol, k), v)
+    return worst
+
+
+def main(argv, env=None, out=print, now_fn=utc_now, urlopen=urllib.request.urlopen):
+    env = os.environ if env is None else env
+    p = argparse.ArgumentParser(prog="v2_run")
+    p.add_argument("command", choices=("morning", "status", "resend", "init", "check-source"))
+    p.add_argument("--mode", choices=sorted(MODES), required=True)
+    p.add_argument("--workdir", required=True)
+    p.add_argument("--code-version", default="")
+    p.add_argument("--date", default=None)
+    p.add_argument("--kind", choices=KINDS, default=None)
+    p.add_argument("--request-id", default=None)
+    p.add_argument("--start-after", default=None)
+    a = p.parse_args(argv)
+    rec, code = Record(), 1
+    scratch = tempfile.mkdtemp(prefix="v2run_")
+    try:
+        s = Setup(a.mode, os.path.abspath(a.workdir), env, urlopen, now_fn, scratch)
+        rec.add("command", a.command)
+        rec.add("mode", a.mode)
+        rec.add("now_utc", s.now.isoformat(timespec="seconds"))
+        rec.add("code_version", a.code_version if _SHA.fullmatch(a.code_version or "") else "unknown")
+        rec.add("git", _git_version(s.git))
+        if a.command == "morning":
+            code = cmd_morning(s, rec)
+        elif a.command == "status":
+            code = cmd_status(s, rec, a.date)
+        elif a.command == "resend":
+            code = cmd_resend(s, rec, a.date, a.kind, a.request_id)
+        elif a.command == "init":
+            code = cmd_init(s, rec, a.start_after)
+        else:
+            code = cmd_check_source(s, rec)
+    except Exception as e:                      # the type name only: an exception text may hold a path or a URL
+        rec.add("failed", type(e).__name__ + ("（%s）" % e.code if isinstance(getattr(e, "code", None), str) else ""))
+        code = 1
+    finally:
+        shutil.rmtree(scratch, True)
+    rec.add("exit_code", code)
+    text = "\n".join(["### v2_run"] + rec.lines)
+    out(text)
+    path = env.get("GITHUB_STEP_SUMMARY")
+    if path:
+        with open(path, "a", encoding="utf-8") as f:
+            f.write(text + "\n")
+    return code
diff --git a/v2_run/web.py b/v2_run/web.py
new file mode 100644
index 0000000..4045acd
--- /dev/null
+++ b/v2_run/web.py
@@ -0,0 +1,117 @@
+"""TRIAL. The two HTTP calls of V2: the chart (v8) daily of one symbol, and one post to a Discord webhook.
+urlopen is injected (the tests never open a socket to the outside). No exception text, URL or body leaves this module."""
+import json
+import socket
+import urllib.error
+import urllib.request
+
+from v2_inputs import chart_url
+
+USER_AGENT = "Mozilla/5.0 (compatible; soxl-alert-v2)"
+FETCH_TIMEOUT = 30
+SEND_TIMEOUT = 20
+MAX_BYTES = 8 * 1024 * 1024
+LIMIT = 1900                                   # Discord allows 2000 characters per message
+PREVIEW_HEAD = "【SOXL日次・ローカルプレビュー（実送信なし）】"
+LIVE_HEAD = "【詳細】"
+WEBHOOK_PREFIXES = ("https://discord.com/api/webhooks/", "https://discordapp.com/api/webhooks/")
+SENT, NOT_STARTED, UNKNOWN = "SENT", "NOT_STARTED", "UNKNOWN"
+
+
+class FetchFailed(Exception):
+    """A fixed word only (never the URL or the body)."""
+
+
+def make_fetch(urlopen=urllib.request.urlopen):
+    """fetch(symbol, start, end) -> bytes, for load_inputs. Any failure raises (load_inputs: input_market_fetch_failed)."""
+    def fetch(symbol, start, end):
+        request = urllib.request.Request(chart_url(symbol, start, end),
+                                         headers={"User-Agent": USER_AGENT, "Accept": "application/json"})
+        with urlopen(request, timeout=FETCH_TIMEOUT) as response:
+            if getattr(response, "status", None) != 200:
+                raise FetchFailed("status")
+            data = response.read(MAX_BYTES + 1)
+        if len(data) > MAX_BYTES:
+            raise FetchFailed("size")
+        return data
+    return fetch
+
+
+def live_text(text):
+    """The text as it is really sent: the preview heading of the core becomes the live one (nothing else changes)."""
+    return text.replace(PREVIEW_HEAD, LIVE_HEAD)
+
+
+def split_text(text, limit=LIMIT):
+    """Parts of at most `limit` characters, cut at line ends (a longer line is cut where it must); one part when short."""
+    if len(text) <= limit:
+        return [text]
+    parts, cur = [], ""
+    for line in text.split("\n"):
+        while len(line) > limit:
+            if cur:
+                parts.append(cur)
+                cur = ""
+            parts.append(line[:limit])
+            line = line[limit:]
+        joined = line if not cur else cur + "\n" + line
+        if len(joined) > limit:
+            parts.append(cur)
+            cur = line
+        else:
+            cur = joined
+    if cur:
+        parts.append(cur)
+    n = len(parts)
+    return ["（%d/%d）\n%s" % (i + 1, n, p) for i, p in enumerate(parts)]
+
+
+class DiscordSender(object):
+    """send(text) -> SENT / NOT_STARTED / UNKNOWN (the S4-B contract). NOT_STARTED only when no part can have been
+    posted: a missing or malformed URL, or the first part refused (4xx) or not connected (DNS, refused connection).
+    Every other failure, and any failure after the first part, is UNKNOWN. No retry."""
+
+    def __init__(self, url, urlopen=urllib.request.urlopen):
+        self._url = url if isinstance(url, str) and url.startswith(WEBHOOK_PREFIXES) and url.isascii() else None
+        self._open = urlopen
+
+    def __repr__(self):
+        return "DiscordSender()"
+
+    def _post(self, content):
+        body = json.dumps({"content": content, "allowed_mentions": {"parse": []}}, ensure_ascii=False).encode("utf-8")
+        request = urllib.request.Request(self._url + "?wait=true", data=body, method="POST",
+                                         headers={"Content-Type": "application/json", "User-Agent": USER_AGENT})
+        try:
+            with self._open(request, timeout=SEND_TIMEOUT) as response:
+                return "ok" if 200 <= getattr(response, "status", 0) < 300 else "unsure"
+        except urllib.error.HTTPError as e:
+            code = e.code
+            e.close()
+            return "refused" if 400 <= code < 500 else "unsure"
+        except urllib.error.URLError as e:
+            refused = isinstance(e.reason, (ConnectionRefusedError, socket.gaierror))
+            return "refused" if refused else "unsure"
+        except Exception:
+            return "unsure"
+
+    def send(self, text):
+        if self._url is None or not isinstance(text, str):
+            return NOT_STARTED
+        for i, part in enumerate(split_text(live_text(text))):
+            outcome = self._post(part)
+            if outcome == "ok":
+                continue
+            return NOT_STARTED if (outcome == "refused" and i == 0) else UNKNOWN
+        return SENT
+
+
+class DrySender(object):
+    """The dry run: nothing leaves the runner; the text goes to the run record. Answers SENT (the dry outbox)."""
+
+    def __init__(self):
+        self.texts = []
+
+    def send(self, text):
+        self.texts.append(text)
+        return SENT
