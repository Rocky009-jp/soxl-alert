index 0000000..367732f
--- /dev/null
+++ b/v2_history_maintain/values.py
@@ -0,0 +1,128 @@
+"""Values of maintenance (C-4): the root report, the unlock plan, the manifest of a set-aside directory and the result.
+Pure; no files. The report is made by the store from what it saw; the plan only repackages a report."""
+import copy
+from dataclasses import dataclass
+from typing import Any
+
+from v2_history.common import is_hex64, is_int
+from v2_history_ops.values import _Frozen, digest_of
+from v2_persistence.codec import canonical_json
+from v2_persistence.local.errors import LocalStoreError
+from v2_recovery.common import valid_request_id
+
+UNLOCK_OPERATION = "soxl-v2-maintenance-unlock/1"
+MANIFEST_FORMAT = "soxl-v2-quarantine/1"
+UNLOCK, MIGRATION, ADOPTION = "UNLOCK", "MIGRATION", "ADOPTION"
+UNLOCKED, MIGRATED, ADOPTED = "UNLOCKED", "MIGRATED", "ADOPTED"
+LOCK_KIND, TMP_KIND, S2_TMP_KIND = "lock", "tmp", "s2tmp"
+TARGET_KEYS = frozenset(["name", "kind", "raw_sha256", "raw_size", "dev", "ino"])
+PLAN_KEYS = frozenset(["operation", "request_id", "writers_stopped", "targets"])
+
+
+def _plan_error(rule):
+    return LocalStoreError("maintenance_plan_invalid", "plan", "args", rule=rule)
+
+
+class RootReport(_Frozen):
+    """What inspect() saw, without a lock: the layout, the identities of history.json and snapshot.json, every leftover
+    lock and temporary file, and the set-aside directories. Only the store makes one."""
+
+    __slots__ = ()
+
+    @classmethod
+    def _of(cls, view):
+        return cls._wrap(view, lambda rule: LocalStoreError("store_io_error", "root", "inspect", rule=rule))
+
+    layout = property(lambda self: copy.deepcopy(self._view["layout"]))
+    history = property(lambda self: copy.deepcopy(self._view["history"]))
+    v1 = property(lambda self: copy.deepcopy(self._view["v1"]))
+    artifacts = property(lambda self: copy.deepcopy(self._view["artifacts"]))
+    quarantine = property(lambda self: copy.deepcopy(self._view["quarantine"]))
+
+    def __repr__(self):
+        return "RootReport(layout=%s, artifacts=%d)" % (self._view["layout"], len(self._view["artifacts"]))
+
+
+class UnlockPlan(_Frozen):
+    """{body, plan_hash}: the leftover lock and temporary files to set aside, named by identity, and the operator's
+    declaration that every writer is stopped. Made only by plan_unlock."""
+
+    __slots__ = ()
+
+    @classmethod
+    def _make(cls, body):
+        return cls._wrap({"body": body, "plan_hash": digest_of(body)}, _plan_error)
+
+    body = property(lambda self: copy.deepcopy(self._view["body"]))
+    plan_hash = property(lambda self: copy.deepcopy(self._view["plan_hash"]))
+
+    def __repr__(self):
+        return "UnlockPlan(targets=%d, plan_hash=%s)" % (len(self._view["body"]["targets"]),
+                                                          self._view["plan_hash"][:12])
+
+
+def plan_unlock(report, request_id, writers_stopped):
+    """An unlock plan from a report. The declaration is the operator's word, not a proof (design 5.1)."""
+    if type(report) is not RootReport:
+        raise _plan_error("report_type")
+    if writers_stopped is not True:
+        raise LocalStoreError("maintenance_declaration_missing", "writers_stopped", "args")
+    if not valid_request_id(request_id):
+        raise _plan_error("request_id")
+    arts = report.artifacts
+    if not arts:
+        raise LocalStoreError("maintenance_nothing_to_unlock", "store", "args")
+    if any(not a["regular"] for a in arts):
+        raise LocalStoreError("maintenance_target_unsupported", "store", "args")
+    targets = [{k: a[k] for k in TARGET_KEYS} for a in arts]
+    targets.sort(key=lambda t: (t["kind"] == LOCK_KIND, t["name"]))
+    body = {"operation": UNLOCK_OPERATION, "request_id": request_id, "writers_stopped": True, "targets": targets}
+    return UnlockPlan._make(body)
+
+
+def check_plan(plan, confirmed_plan_hash):
+    """The body of a plan whose type, form and hash are right and whose hash the operator confirmed."""
+    if type(plan) is not UnlockPlan:
+        raise _plan_error("type")
+    view = plan.to_dict()
+    body = view.get("body")
+    if not isinstance(body, dict) or set(body) != PLAN_KEYS or body["operation"] != UNLOCK_OPERATION:
+        raise _plan_error("shape")
+    if body["writers_stopped"] is not True or not valid_request_id(body["request_id"]):
+        raise _plan_error("shape")
+    targets = body["targets"]
+    if not isinstance(targets, list) or not targets:
+        raise _plan_error("shape")
+    names = set()
+    for i, t in enumerate(targets):
+        if (not isinstance(t, dict) or set(t) != TARGET_KEYS or t["kind"] not in (LOCK_KIND, TMP_KIND, S2_TMP_KIND)
+                or type(t["name"]) is not str or not is_hex64(t["raw_sha256"])
+                or not all(is_int(t[k]) and t[k] >= 0 for k in ("raw_size", "dev", "ino"))
+                or t["name"] in names or (t["kind"] == LOCK_KIND and i != len(targets) - 1)):
+            raise _plan_error("shape")
+        names.add(t["name"])
+    if not is_hex64(view.get("plan_hash")) or view["plan_hash"] != digest_of(body):
+        raise _plan_error("plan_hash")
+    if confirmed_plan_hash != view["plan_hash"]:
+        raise LocalStoreError("maintenance_plan_unconfirmed", "plan", "args")
+    return body
+
+
+def manifest_bytes(operation, key, request_id, plan_hash, publication_hash, writers_stopped, targets):
+    """The fixed text of quarantine/<key>/MANIFEST: what is set aside and why. No path, clock or free text."""
+    view = {"format": MANIFEST_FORMAT, "operation": operation, "key": key, "request_id": request_id,
+            "plan_hash": plan_hash, "publication_hash": publication_hash, "writers_stopped": writers_stopped,
+            "targets": [{"name": t["name"], "kind": t["kind"], "raw_sha256": t["raw_sha256"],
+                         "raw_size": t["raw_size"]} for t in targets]}
+    return canonical_json(view).encode("utf-8")
+
+
+@dataclass(frozen=True)
+class MaintenanceResult:
+    """Only a normal completion returns this. `resumed` says a set-aside directory of an earlier attempt was found and
+    continued (or already complete). Not a right to notify."""
