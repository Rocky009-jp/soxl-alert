@@ -0,0 +1,15 @@
+"""MaintenanceOps: S2's FileOps (unchanged, inherited) plus the two OS calls that maintenance needs and S2 does not
+have: making a directory and renaming a file within the same root. Nothing here decides policy or retries."""
+import os
+
+from v2_persistence.local.fsops import FileOps
+
+
+class MaintenanceOps(FileOps):
+    def mkdir(self, path):
+        """A new directory; fails with FileExistsError if anything (even a dangling link) is at the path."""
+        os.mkdir(path, 0o700)
+
+    def rename(self, src, dst):
+        """A rename within one file system. The caller has checked, under the lock, that nothing is at dst."""
+        os.rename(src, dst)
diff --git a/v2_history_maintain/store.py b/v2_history_maintain/store.py
new file mode 100644
index 0000000..5cff332
--- /dev/null
+++ b/v2_history_maintain/store.py
@@ -0,0 +1,865 @@
+"""HistoryMaintenance: the maintenance operations of a history root (C-4). Trial.
+
+inspect (no lock, read-only), read_original / read_set_aside (under the lock, read-only), unlock (a confirmed plan),
+migrate (a MIGRATION publication) and adopt (an ADOPTION publication). Everything set aside goes to
+quarantine/<key>/ with a MANIFEST written first. Lock, scan and publish follow C-3 step by step over S2's FileOps plus
+mkdir and rename (MaintenanceOps). No clock, network, retry, automatic repair or automatic unlock."""
+import os
+import secrets
+import stat
+
+from v2_core.errors import CoreError
+from v2_history_publish import (ADOPTION as SRC_ADOPTION, CREATE, MIGRATION as SRC_MIGRATION, PUBLISHED,
+                                PUBLISHED_THEN_EXTENDED, REPLACE, HistoryPublication, check_publication,
+                                history_bytes, raw_identity, read_history_bytes, reconcile_publication)
+from v2_persistence.local.errors import (CLEANUP_LOCK_FOREIGN, CLEANUP_LOCK_LEFT, CLEANUP_TMP_LEFT,
+                                         CLEANUP_TMP_UNCONFIRMED, LocalStoreError)
+from v2_persistence.local.results import FILE_AND_DIRECTORY_SYNC, FILE_SYNC_ONLY
+from v2_persistence.local.store import FILE_SYNC_ONLY_MODE, STRICT
+
+from .ops import MaintenanceOps
+from .values import (ADOPTED, ADOPTION, LOCK_KIND, MIGRATED, MIGRATION, S2_TMP_KIND, TMP_KIND, UNLOCK, UNLOCKED,
+                     MaintenanceResult, RootReport, check_plan, manifest_bytes)
+
+HISTORY_NAME = "history.json"
+V1_NAME = "snapshot.json"
+LOCK_NAME = "write.lock"
+TMP_PREFIX, TMP_SUFFIX = ".history.", ".tmp"
+S2_TMP_PREFIX = ".snapshot."
+QUARANTINE = "quarantine"
+MANIFEST = "MANIFEST"
+Q_TMP_PREFIX = ".q."
+LOCK_MAGIC = b"v2_history_maintain.lock\n"
+OWNERS = ((b"v2_persistence.local.lock\n", "S2"), (b"v2_history_local.lock\n", "C3"), (LOCK_MAGIC, "C4"))
+_MODES = (STRICT, FILE_SYNC_ONLY_MODE)
+_PUBLICATION_CODES = ("publication_invalid", "publication_stale")
+_HEX = frozenset("0123456789abcdef")
+
+
+def _is_hex(s, n):
+    return len(s) == n and set(s) <= _HEX
+
+
+def _tmp_kind(name):
+    if name.endswith(TMP_SUFFIX):
+        if name.startswith(TMP_PREFIX):
+            return TMP_KIND
+        if name.startswith(S2_TMP_PREFIX):
+            return S2_TMP_KIND
+    return None
+
+
+def _q_tmp(name):
+    return name.startswith(Q_TMP_PREFIX) and name.endswith(TMP_SUFFIX) and _is_hex(name[3:-4], 32)
+
+
+def _owner(data):
+    if not data:
+        return "EMPTY"
+    for magic, who in OWNERS:
+        if data.startswith(magic):
+            return who
+    return "UNKNOWN"
+
+
+class _Lock:
+    __slots__ = ("path", "dev", "ino", "marker")
+
+    def __init__(self, path, dev, ino, marker):
+        self.path, self.dev, self.ino, self.marker = path, dev, ino, marker
+
+
+class _Ctx:
+    __slots__ = ("published", "changed", "moved")
+
+    def __init__(self):
+        self.published = False
+        self.changed = False
+        self.moved = False
+
+
+def _publication(publication, source):
+    if type(publication) is not HistoryPublication:
+        raise LocalStoreError("store_publication_invalid", "publication", "args", rule="type")
+    err = None
+    try:
+        body = publication.to_dict()["body"]
+        mode, src = body["mode"], body["source"]
+    except Exception:
+        err = LocalStoreError("store_publication_invalid", "publication", "args", rule="shape")
+    if err is not None:
+        raise err
+    want = CREATE if source == SRC_MIGRATION else REPLACE
+    if mode != want or src != source:
+        raise LocalStoreError("store_operation_unsupported", "publication", "args",
+                              rule="not_migration" if source == SRC_MIGRATION else "not_adoption")
+    return body
+
+
+def _checked(current, publication, source_v1=None):
+    err = None
+    try:
+        if source_v1 is None:
+            return check_publication(current, publication)
+        return check_publication(current, publication, source_v1)
+    except CoreError as e:
+        if e.code in _PUBLICATION_CODES:
+            raise
+        err = LocalStoreError("store_candidate_invalid", "publication", "candidate")
+    if err is not None:
+        raise err
+
+
+class HistoryMaintenance:
+    def __init__(self, root, writable=False, durability=STRICT, *, _ops=None):
+        self._ops = MaintenanceOps() if _ops is None else _ops
+        self._root_arg = root
+        if durability not in _MODES:
+            raise LocalStoreError("store_config_invalid", "durability", "args")
+        if type(writable) is not bool:
+            raise LocalStoreError("store_config_invalid", "writable", "args")
+        self._writable = writable
+        self._durability = durability
+        self._dir = self._check_root()
+
+    def __repr__(self):
+        return "HistoryMaintenance(writable=%s, durability=%s)" % (self._writable, self._durability)
+
+    @property
+    def persistence_level(self):
+        return FILE_AND_DIRECTORY_SYNC if self._durability == STRICT else FILE_SYNC_ONLY
+
+    # --- public API ------------------------------------------------------------------------------------------
+    def inspect(self):
+        """What is in the root, without a lock and without changing anything (the lock may be a leftover)."""
+        self._dir = self._check_root()
+        ops = self._ops
+        names = self._listdir(self._dir, "inspect")
+        arts = []
+        for name in sorted(names):
+            kind = LOCK_KIND if name == LOCK_NAME else _tmp_kind(name)
+            if kind is None:
+                continue
+            arts.append(self._artifact(name, kind))
+        hist = v1 = None
+        if HISTORY_NAME in names:
+            data = self._read_regular(HISTORY_NAME, "inspect")
+            readable = True
+            try:
+                read_history_bytes(data)
+            except CoreError:
+                readable = False
+            hist = dict(raw_identity(data), readable=readable)
+        if V1_NAME in names:
+            v1 = raw_identity(self._read_regular(V1_NAME, "inspect"))
+        layout = {(False, False): "EMPTY", (True, False): "V2", (False, True): "V1_ONLY",
+                  (True, True): "V1_AND_V2"}[(hist is not None, v1 is not None)]
+        quarantine = None
+        if QUARANTINE in names:
+            qdir = self._quarantine_dir(create=False, phase="inspect")
+            quarantine = []
+            for key in sorted(self._listdir(qdir, "inspect")):
+                if not _is_hex(key, 64):
+                    continue
+                kdir = os.path.join(qdir, key)
+                err = None
+                try:
+                    st = ops.lstat(kdir)
+                except Exception:
+                    err = LocalStoreError("store_io_error", "quarantine", "inspect")
+                if err is not None:
+                    raise err
+                if ops.is_link_like(st) or not stat.S_ISDIR(st.st_mode):
+                    quarantine.append({"key": key, "manifest": None, "names": None})
+                    continue
+                entries = sorted(self._listdir(kdir, "inspect"))
+                manifest = None
+                if MANIFEST in entries:
+                    manifest = self._manifest_summary(os.path.join(kdir, MANIFEST))
+                quarantine.append({"key": key, "manifest": manifest, "names": entries})
+        return RootReport._of({"layout": layout, "history": hist, "v1": v1, "artifacts": arts,
+                               "quarantine": quarantine})
+
+    def read_original(self, name):
+        """The raw bytes of history.json or snapshot.json, read under the lock (for planning; not validated)."""
+        if name not in (HISTORY_NAME, V1_NAME):
+            raise LocalStoreError("store_config_invalid", "name", "args")
+        self._dir = self._check_root()
+        return self._locked(lambda lock, ctx: self._load(name))
+
+    def read_set_aside(self, key, name):
+        """The bytes set aside under quarantine/<key>/<name>, checked against its MANIFEST, read under the lock."""
+        if type(key) is not str or not _is_hex(key, 64) or name not in (HISTORY_NAME, V1_NAME):
+            raise LocalStoreError("store_config_invalid", "key", "args")
+        self._dir = self._check_root()
+
+        def body(lock, ctx):
+            kdir = os.path.join(self._quarantine_dir(create=False, phase="read"), key)
+            self._real_dir(kdir, "read")
+            mdata = self._read_path(os.path.join(kdir, MANIFEST), "read")
+            target = self._manifest_target(mdata, key, name)
+            data = self._read_path(os.path.join(kdir, name), "read")
+            if raw_identity(data) != {"raw_sha256": target["raw_sha256"], "raw_size": target["raw_size"]}:
+                raise LocalStoreError("maintenance_set_aside_mismatch", "quarantine", "read")
+            return data
+        return self._locked(body)
+
+    def unlock(self, plan, confirmed_plan_hash):
+        """Set aside the leftover temporary files and lock that the confirmed plan names. When the plan names the lock,
+        it is the exclusion of this operation and is moved last; otherwise a lock of this operation is taken."""
+        body = check_plan(plan, confirmed_plan_hash)
+        key = plan.plan_hash
+        self._require_writable()
+        self._dir = self._check_root()
+        targets = body["targets"]
+        has_lock = targets[-1]["kind"] == LOCK_KIND
+        manifest = manifest_bytes(UNLOCK, key, body["request_id"], key, None, True, targets)
+
+        def steps(lock, ctx):
+            self._probe_durability()
+            kdir, resumed = self._prepare_unlock(ctx, targets, key, manifest, lock)
+            self._ensure_manifest(ctx, kdir, manifest)
+            for t in targets:
+                src = self._managed(t["name"])
+                if not self._exists(src):
+                    continue                                    # moved by an earlier attempt (checked above)
+                self._move(ctx, src, os.path.join(kdir, t["name"]), t)
+            self._sync_dirs(ctx, kdir)
+            return MaintenanceResult(UNLOCKED, key, resumed, None, self.persistence_level)
+
+        def run(lock, ctx):
+            err = None
+            try:
+                return steps(lock, ctx)
+            except LocalStoreError as e:
+                if not ctx.moved or e.code == "maintenance_incomplete":
+                    raise
+                err = LocalStoreError("maintenance_incomplete", "quarantine", e.phase, cleanup=e.cleanup,
+                                      primary=e.code)
+            raise err
+        if has_lock:
+            return run(None, _Ctx())
+        return self._locked(run)
+
+    def migrate(self, publication, writers_stopped):
+        """v1 -> v2 from a MIGRATION publication: MANIFEST, history.json (temporary file and one replace), then
+        snapshot.json into quarantine/<key>/. A resumed attempt only does what is left."""
+        body = _publication(publication, SRC_MIGRATION)
+        if writers_stopped is not True:
+            raise LocalStoreError("maintenance_declaration_missing", "writers_stopped", "args")
+        self._require_writable()
+        self._dir = self._check_root()
+        key = publication.publication_hash
+        src = body["source_v1"]
+        targets = [{"name": V1_NAME, "kind": "v1", "raw_sha256": src["raw_sha256"], "raw_size": src["raw_size"]}]
+        manifest = manifest_bytes(MIGRATION, key, body["request_id"], body["plan_hash"], key, True, targets)
+
+        def run(lock, ctx):
+            names = self._scan()
+            has_v1, has_h = V1_NAME in names, HISTORY_NAME in names
+            kdir = os.path.join(self._quarantine_dir(create=False, phase="quarantine"), key) \
+                if QUARANTINE in names else None
+            if has_v1 and not has_h:
+                v1 = self._load(V1_NAME)
+                candidate = _checked(None, publication, v1)
+                self._probe_durability()
+                kdir, resumed = self._key_dir(ctx, key, manifest, allowed=())
+                self._ensure_manifest(ctx, kdir, manifest)
+                self._publish(lock, ctx, history_bytes(candidate))
+                self._move(ctx, self._managed(V1_NAME), os.path.join(kdir, V1_NAME), targets[0], check_ino=False)
+                self._sync_dirs(ctx, kdir)
+                return MaintenanceResult(MIGRATED, key, resumed, candidate, self.persistence_level)
+            if has_v1 and has_h:
+                v1, data = self._load(V1_NAME), self._load(HISTORY_NAME)
+                if raw_identity(v1) != src or reconcile_publication(data, publication).outcome != PUBLISHED \
+                        or kdir is None:
+                    raise LocalStoreError("maintenance_state_unexpected", "store", "scan", rule="v1_and_v2")
+                self._probe_durability()
+                kdir, _ = self._key_dir(ctx, key, manifest, allowed=(), must_exist=True)
+                self._move(ctx, self._managed(V1_NAME), os.path.join(kdir, V1_NAME), targets[0], check_ino=False)
+                self._sync_dirs(ctx, kdir)
+                return MaintenanceResult(MIGRATED, key, True, read_history_bytes(data)[0], self.persistence_level)
+            if has_h:
+                data = self._load(HISTORY_NAME)
+                outcome = reconcile_publication(data, publication).outcome
+                if outcome not in (PUBLISHED, PUBLISHED_THEN_EXTENDED) or kdir is None:
+                    raise LocalStoreError("maintenance_state_unexpected", "store", "scan", rule="v2_present")
+                kdir, _ = self._key_dir(ctx, key, manifest, allowed=(V1_NAME,), must_exist=True)
+                if raw_identity(self._read_path(os.path.join(kdir, V1_NAME), "read")) != src:
+                    raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "quarantine",
+                                          rule="target")
+                return MaintenanceResult(MIGRATED, key, True, read_history_bytes(data)[0], self.persistence_level)
+            raise LocalStoreError("maintenance_state_unexpected", "store", "scan", rule="empty")
+        return self._locked(run)
+
+    def adopt(self, publication):
+        """A prefix adoption from an ADOPTION publication: MANIFEST, a copy of the original bytes of history.json in
+        quarantine/<key>/ (checked by reading it back), then the candidate by a temporary file and one replace."""
+        body = _publication(publication, SRC_ADOPTION)
+        self._require_writable()
+        self._dir = self._check_root()
+        key = publication.publication_hash
+        exp = body["expected"]
+        target = {"name": HISTORY_NAME, "kind": "history", "raw_sha256": exp["raw_sha256"],
+                  "raw_size": exp["raw_size"]}
+        manifest = manifest_bytes(ADOPTION, key, body["request_id"], body["plan_hash"], key, False, [target])
+
+        def run(lock, ctx):
+            names = self._scan()
+            if V1_NAME in names:
+                raise LocalStoreError("store_layout_unsupported", "store", "scan",
+                                      rule="v1_and_v2" if HISTORY_NAME in names else "v1_only")
+            data = self._load(HISTORY_NAME)
+            if raw_identity(data) != exp:
+                outcome = reconcile_publication(data, publication).outcome
+                if outcome not in (PUBLISHED, PUBLISHED_THEN_EXTENDED) or QUARANTINE not in names:
+                    _checked(data, publication)                 # publication_stale / raw, as C-2 says
+                    raise LocalStoreError("maintenance_state_unexpected", "store", "scan", rule="adoption")
+                kdir, _ = self._key_dir(ctx, key, manifest, allowed=(HISTORY_NAME,), must_exist=True)
+                if raw_identity(self._read_path(os.path.join(kdir, HISTORY_NAME), "read")) != exp:
+                    raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "quarantine",
+                                          rule="target")
+                return MaintenanceResult(ADOPTED, key, True, read_history_bytes(data)[0], self.persistence_level)
+            candidate = _checked(data, publication)
+            self._probe_durability()
+            kdir, resumed = self._key_dir(ctx, key, manifest, allowed=(HISTORY_NAME,))
+            self._ensure_manifest(ctx, kdir, manifest)
+            copy_path = os.path.join(kdir, HISTORY_NAME)
+            if not self._exists(copy_path):
+                self._write_new(ctx, kdir, HISTORY_NAME, data, "copy")
+                if self._durability == STRICT:
+                    self._fsync_dir(kdir, "copy")
+            if raw_identity(self._read_path(copy_path, "copy")) != exp:
+                raise LocalStoreError("maintenance_copy_mismatch", "quarantine", "copy")
+            self._publish(lock, ctx, history_bytes(candidate))
+            return MaintenanceResult(ADOPTED, key, resumed, candidate, self.persistence_level)
+        return self._locked(run)
+
+    # --- configuration and root ------------------------------------------------------------------------------
+    def _require_writable(self):
+        if not self._writable:
+            raise LocalStoreError("store_read_only", "store", "args")
+
+    def _check_root(self):
+        ops = self._ops
+        try:
+            raw = os.fspath(self._root_arg)
+        except TypeError:
+            raw = None
+        ok, real = False, None
+        if isinstance(raw, str) and raw and "\0" not in raw and os.path.isabs(raw):
+            path = os.path.abspath(raw)
+            try:
+                st = ops.lstat(path)
+                ok = stat.S_ISDIR(st.st_mode) and not ops.is_link_like(st)
+                if ok:
+                    real = os.path.realpath(path)
+            except Exception:
+                ok = False
+        if not ok or real is None:
+            raise LocalStoreError("store_root_invalid", "root", "root")
+        return real
+
+    def _managed(self, name):
+        path = os.path.join(self._dir, name)
+        if os.path.dirname(path) != self._dir:
+            raise LocalStoreError("store_root_invalid", "root", "root")
+        return path
+
+    def _listdir(self, path, phase):
+        err = None
+        try:
+            return self._ops.listdir(path)
+        except Exception:
+            err = LocalStoreError("store_io_error", "root", phase)
+        if err is not None:
+            raise err
+
+    def _exists(self, path):
+        try:
+            self._ops.lstat(path)
+        except Exception:
+            return False
+        return True
+
+    def _stat_or_none(self, path):
+        try:
+            return self._ops.lstat(path)
+        except Exception:
+            return None
+
+    def _read_path(self, path, phase):
+        """Whole content of a regular file that is not a link, with the same identity before and after opening."""
+        ops = self._ops
+        err = None
+        try:
+            st = ops.lstat(path)
+        except FileNotFoundError:
+            err = LocalStoreError("maintenance_quarantine_invalid", "quarantine", phase, rule="missing")
+        except Exception:
+            err = LocalStoreError("store_io_error", "quarantine", phase)
+        if err is not None:
+            raise err
+        if ops.is_link_like(st) or not stat.S_ISREG(st.st_mode):
+            raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", phase, rule="type")
+        err = None
+        try:
+            data, st2 = ops.read_file(path)
+        except Exception:
+            err = LocalStoreError("store_io_error", "quarantine", phase)
+        if err is not None:
+            raise err
+        if (st.st_dev, st.st_ino) != (st2.st_dev, st2.st_ino):
+            raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", phase, rule="type")
+        return data
+
+    def _read_regular(self, name, phase):
+        ops = self._ops
+        path = self._managed(name)
+        err = None
+        try:
+            st = ops.lstat(path)
+            if ops.is_link_like(st) or not stat.S_ISREG(st.st_mode):
+                raise LocalStoreError("store_root_invalid", "root", phase)
+            data, st2 = ops.read_file(path)
+        except LocalStoreError:
+            raise
+        except Exception:
+            err = LocalStoreError("store_io_error", "history", phase)
+        if err is not None:
+            raise err
+        if (st.st_dev, st.st_ino) != (st2.st_dev, st2.st_ino):
+            raise LocalStoreError("store_root_invalid", "root", phase)
+        return data
+
+    def _artifact(self, name, kind):
+        ops = self._ops
+        path = self._managed(name)
+        err = None
+        try:
+            st = ops.lstat(path)
+        except Exception:
+            err = LocalStoreError("store_io_error", "root", "inspect")
+        if err is not None:
+            raise err
+        regular = stat.S_ISREG(st.st_mode) and not ops.is_link_like(st)
+        art = {"name": name, "kind": kind, "regular": regular, "owner": None, "raw_sha256": None, "raw_size": None,
+               "dev": None, "ino": None}
+        if regular:
+            data = self._read_regular(name, "inspect")
+            art.update(raw_identity(data))
+            art["dev"], art["ino"] = st.st_dev, st.st_ino
+            if kind == LOCK_KIND:
+                art["owner"] = _owner(data)
+        return art
+
+    def _manifest_summary(self, path):
+        import json
+        try:
+            data = self._read_path(path, "inspect")
+            view = json.loads(data.decode("utf-8"))
+            return {"operation": view["operation"], "request_id": view["request_id"],
+                    "targets": [t["name"] for t in view["targets"]]}
+        except LocalStoreError:
+            raise
+        except Exception:
+            return None
+
+    def _manifest_target(self, mdata, key, name):
+        import json
+        try:
+            view = json.loads(mdata.decode("utf-8"))
+            if view["key"] != key:
+                raise ValueError
+            for t in view["targets"]:
+                if t["name"] == name:
+                    return t
+        except Exception:
+            pass
+        raise LocalStoreError("maintenance_set_aside_mismatch", "quarantine", "read")
+
+    # --- durability ------------------------------------------------------------------------------------------
+    def _probe_durability(self):
+        ops = self._ops
+        if self._durability != STRICT:
+            return
+        if ops.is_windows():
+            raise LocalStoreError("store_durability_unsupported", "durability", "durability_probe",
+                                  rule="windows_strict")
+        err = None
+        try:
+            ops.probe_dir_sync(self._dir)
+        except Exception:
+            err = LocalStoreError("store_durability_unsupported", "durability", "durability_probe",
+                                  rule="directory_sync")
+        if err is not None:
+            raise err
+
+    def _fsync_dir(self, path, phase):
+        err = None
+        try:
+            self._ops.fsync_dir(path)
+        except Exception:
+            err = LocalStoreError("maintenance_incomplete", "quarantine", phase)
+        if err is not None:
+            raise err
+
+    def _sync_dirs(self, ctx, kdir):
+        if self._durability == STRICT:
+            self._fsync_dir(kdir, "move")
+            self._fsync_dir(self._dir, "move")
+
+    # --- quarantine ------------------------------------------------------------------------------------------
+    def _real_dir(self, path, phase):
+        ops = self._ops
+        err = None
+        try:
+            st = ops.lstat(path)
+            root = ops.lstat(self._dir)
+        except FileNotFoundError:
+            err = LocalStoreError("maintenance_quarantine_invalid", "quarantine", phase, rule="missing")
+        except Exception:
+            err = LocalStoreError("store_io_error", "quarantine", phase)
+        if err is not None:
+            raise err
+        if ops.is_link_like(st) or not stat.S_ISDIR(st.st_mode) or st.st_dev != root.st_dev:
+            raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", phase, rule="type")
+
+    def _quarantine_dir(self, create, phase, ctx=None):
+        path = self._managed(QUARANTINE)
+        if create and not self._exists(path):
+            err = None
+            try:
+                self._ops.mkdir(path)
+            except Exception:
+                err = LocalStoreError("store_io_error", "quarantine", phase)
+            if err is not None:
+                raise err
+            ctx.changed = True
+            if self._durability == STRICT:
+                self._fsync_dir(self._dir, phase)
+        self._real_dir(path, phase)
+        return path
+
+    def _key_dir(self, ctx, key, manifest, allowed, must_exist=False):
+        """quarantine/<key>/: made now, or (resumed) found with only its MANIFEST, the allowed names and temporary
+        files of this package. Its MANIFEST, when present, must be exactly `manifest`."""
+        qdir = self._quarantine_dir(create=not must_exist, phase="quarantine", ctx=ctx)
+        kdir = os.path.join(qdir, key)
+        if not self._exists(kdir):
+            if must_exist:
+                raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "quarantine", rule="missing")
+            err = None
+            try:
+                self._ops.mkdir(kdir)
+            except Exception:
+                err = LocalStoreError("store_io_error", "quarantine", "quarantine")
+            if err is not None:
+                raise err
+            ctx.changed = True
+            if self._durability == STRICT:
+                self._fsync_dir(qdir, "quarantine")
+            self._real_dir(kdir, "quarantine")
+            return kdir, False
+        self._real_dir(kdir, "quarantine")
+        for name in self._listdir(kdir, "quarantine"):
+            if name == MANIFEST or name in allowed or _q_tmp(name):
+                continue
+            raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "quarantine", rule="entries")
+        mpath = os.path.join(kdir, MANIFEST)
+        if self._exists(mpath):
+            if self._read_path(mpath, "quarantine") != manifest:
+                raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "quarantine", rule="manifest")
+        elif must_exist:
+            raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "quarantine", rule="manifest")
+        return kdir, True
+
+    def _ensure_manifest(self, ctx, kdir, manifest):
+        if self._exists(os.path.join(kdir, MANIFEST)):
+            return
+        self._write_new(ctx, kdir, MANIFEST, manifest, "manifest")
+        if self._durability == STRICT:
+            self._fsync_dir(kdir, "manifest")
+
+    def _write_new(self, ctx, dirpath, name, data, phase):
+        """A complete file `dirpath/name` by a temporary file of this package and one replace (never partial)."""
+        ops = self._ops
+        tmp = os.path.join(dirpath, Q_TMP_PREFIX + secrets.token_hex(16) + TMP_SUFFIX)
+        fd = st = writer = None
+        failed = False
+        try:
+            fd = ops.create_exclusive(tmp)
+            ctx.changed = True
+            st = ops.fstat(fd)
+            writer = ops.open_writer(fd)
+            fd = None
+            self._write_all(writer, data)
+            ops.flush(writer)
+            ops.fsync_file(writer)
+            ops.close(writer)
+            writer = None
+            ops.replace(tmp, os.path.join(dirpath, name))
+        except Exception:
+            failed = True
+        if failed:
+            tokens = self._discard_own(tmp, st, writer, fd, CLEANUP_TMP_LEFT)
+            raise LocalStoreError("maintenance_incomplete", "quarantine", phase, cleanup=tokens)
+
+    def _move(self, ctx, src, dst, target, check_ino=True):
+        """Rename one target into the set-aside directory after checking, under the lock, that it is still the file
+        the plan names and that nothing is at the destination."""
+        ops = self._ops
+        err = None
+        try:
+            st = ops.lstat(src)
+            data, st2 = ops.read_file(src)
+        except Exception:
+            err = LocalStoreError("maintenance_plan_stale", "store", "move")
+        if err is not None:
+            raise err
+        ident = raw_identity(data)
+        same = (ident["raw_sha256"], ident["raw_size"]) == (target["raw_sha256"], target["raw_size"]) \
+            and (st.st_dev, st.st_ino) == (st2.st_dev, st2.st_ino) and stat.S_ISREG(st.st_mode) \
+            and not ops.is_link_like(st)
+        if check_ino:
+            same = same and (st.st_dev, st.st_ino) == (target["dev"], target["ino"])
+        if not same:
+            raise LocalStoreError("maintenance_plan_stale", "store", "move")
+        if self._exists(dst):
+            raise LocalStoreError("maintenance_quarantine_invalid", "quarantine", "move", rule="entries")
+        err = None
+        try:
+            ops.rename(src, dst)
+        except Exception:
+            err = LocalStoreError("maintenance_incomplete", "quarantine", "move")
+        if err is not None:
+            raise err
+        ctx.changed = ctx.moved = True
+
+    def _prepare_unlock(self, ctx, targets, key, manifest, own_lock):
+        """Every target is either still in the root with its identity, or (resumed) already in quarantine/<key>/
+        with its identity; no other leftover lock or temporary file is in the root."""
+        names = set(self._listdir(self._dir, "scan"))
+        present = set()
+        for name in names:
+            kind = LOCK_KIND if name == LOCK_NAME else _tmp_kind(name)
+            if kind is not None and not (own_lock is not None and name == LOCK_NAME):
+                present.add(name)
+        planned = {t["name"] for t in targets}
+        if not present <= planned:
+            raise LocalStoreError("maintenance_plan_stale", "store", "scan")
+        for t in targets:
+            if t["name"] in present:
+                st = self._stat_or_none(self._managed(t["name"]))
+                if st is None or (st.st_dev, st.st_ino) != (t["dev"], t["ino"]):
+                    raise LocalStoreError("maintenance_plan_stale", "store", "scan")
+        moved = [t for t in targets if t["name"] not in present]
+        if not moved:
+            kdir, resumed = self._key_dir(ctx, key, manifest, allowed=tuple(planned))
+            return kdir, resumed
+        kdir, _ = self._key_dir(ctx, key, manifest, allowed=tuple(planned), must_exist=True)
+        for t in moved:
+            p = os.path.join(kdir, t["name"])
+            st = self._stat_or_none(p)
+            if st is None or (st.st_dev, st.st_ino) != (t["dev"], t["ino"]) or \
+                    raw_identity(self._read_path(p, "scan")) != {"raw_sha256": t["raw_sha256"],
+                                                                 "raw_size": t["raw_size"]}:
+                raise LocalStoreError("maintenance_plan_stale", "store", "scan")
+        return kdir, True
+
+    # --- scan and load (C-3) ---------------------------------------------------------------------------------
+    def _scan(self):
+        names = self._listdir(self._dir, "scan")
+        for name in names:
+            if _tmp_kind(name) is not None:
+                raise LocalStoreError("store_artifact_present", "store", "scan")
+        return set(names)
+
+    def _load(self, name):
+        ops = self._ops
+        path = self._managed(name)
+        err = None
+        try:
+            st = ops.lstat(path)
+        except FileNotFoundError:
+            err = LocalStoreError("store_uninitialized", "store", "read")
+        except Exception:
+            err = LocalStoreError("store_io_error", "history", "read")
+        if err is not None:
+            raise err
+        if ops.is_link_like(st) or not stat.S_ISREG(st.st_mode):
+            raise LocalStoreError("store_root_invalid", "root", "read")
+        err = None
+        try:
+            data, st2 = ops.read_file(path)
+        except Exception:
+            err = LocalStoreError("store_io_error", "history", "read")
+        if err is not None:
+            raise err
+        if (st.st_dev, st.st_ino) != (st2.st_dev, st2.st_ino):
+            raise LocalStoreError("store_root_invalid", "root", "read")
+        return data
+
+    # --- lock (C-3, S2) --------------------------------------------------------------------------------------
+    def _write_all(self, writer, data):
+        ops = self._ops
+        view = memoryview(data)
+        done = 0
+        while done < len(view):
+            n = ops.write(writer, view[done:])
+            if type(n) is not int or n <= 0 or n > len(view) - done:
+                raise OSError("bad write count")
+            done += n
+
+    def _acquire(self):
+        ops = self._ops
+        path = self._managed(LOCK_NAME)
+        marker = LOCK_MAGIC + secrets.token_hex(16).encode("ascii") + b"\n"
+        err, fd = None, None
+        try:
+            fd = ops.create_exclusive(path)
+        except FileExistsError:
+            err = LocalStoreError("store_busy", "lock", "lock_acquire")
+        except Exception:
+            err = LocalStoreError("store_io_error", "lock", "lock_acquire")
+            if self._exists(path):
+                err = LocalStoreError("store_busy", "lock", "lock_acquire")
+        if err is not None:
+            raise err
+        st, writer, failed = None, None, False
+        try:
+            st = ops.fstat(fd)
+            writer = ops.open_writer(fd)
+            fd = None
+            self._write_all(writer, marker)
+            ops.close(writer)
+            writer = None
+        except Exception:
+            failed = True
+        if failed:
+            tokens = self._discard_own(path, st, writer, fd, CLEANUP_LOCK_LEFT)
+            raise LocalStoreError("store_io_error", "lock", "lock_acquire", cleanup=tokens)
+        return _Lock(path, st.st_dev, st.st_ino, marker)
+
+    def _owns(self, lock):
+        ops = self._ops
+        try:
+            st = ops.lstat(lock.path)
+            if ops.is_link_like(st) or not stat.S_ISREG(st.st_mode) or (st.st_dev, st.st_ino) != (lock.dev, lock.ino):
+                return False
+            data, st2 = ops.read_file(lock.path)
+            return data == lock.marker and (st2.st_dev, st2.st_ino) == (lock.dev, lock.ino)
+        except Exception:
+            return False
+
+    def _release(self, lock):
+        if not self._owns(lock):
+            return "lost"
+        try:
+            self._ops.unlink(lock.path)
+        except Exception:
+            return "failed"
+        return None
+
+    def _locked(self, body):
+        lock = self._acquire()
+        ctx, exc, value = _Ctx(), None, None
+        try:
+            value = body(lock, ctx)
+        except Exception as e:
+            exc = e
+        rel = self._release(lock)
+        if rel is None:
+            if exc is not None:
+                raise exc
+            return value
+        token = CLEANUP_LOCK_FOREIGN if rel == "lost" else CLEANUP_LOCK_LEFT
+        phase = "lock_ownership" if rel == "lost" else "lock_release"
+        earlier = tuple(getattr(exc, "cleanup", ())) if isinstance(exc, LocalStoreError) else ()
+        cleanup = earlier + tuple(t for t in (token,) if t not in earlier)
+        if ctx.published:
+            if isinstance(exc, LocalStoreError) and exc.code == "store_commit_uncertain":
+                raise exc.add_cleanup(token)
+            raise LocalStoreError("store_commit_uncertain", "history", phase, cleanup=cleanup,
+                                  primary=getattr(exc, "code", None))
+        if ctx.changed:
+            raise LocalStoreError("maintenance_incomplete", "lock", phase, cleanup=cleanup,
+                                  primary=getattr(exc, "code", None))
+        if isinstance(exc, LocalStoreError) and exc.code == "store_lock_ownership_lost" and rel == "lost":
+            raise exc.add_cleanup(token)
+        code = "store_lock_ownership_lost" if rel == "lost" else "store_io_error"
+        raise LocalStoreError(code, "lock", phase, cleanup=cleanup, primary=getattr(exc, "code", None))
+
+    # --- publishing (C-3) ------------------------------------------------------------------------------------
+    def _discard_own(self, path, st, writer, fd, left_token):
+        ops = self._ops
+        if writer is not None:
+            try:
+                ops.close(writer)
+            except Exception:
+                pass
+        elif fd is not None:
+            try:
+                ops.close_fd(fd)
+            except Exception:
+                pass
+        if st is None:
+            return (left_token,)
+        try:
+            now = ops.lstat(path)
+        except FileNotFoundError:
+            return ()
+        except Exception:
+            return (left_token,)
+        if (now.st_dev, now.st_ino) != (st.st_dev, st.st_ino):
+            return (CLEANUP_TMP_UNCONFIRMED,) if left_token == CLEANUP_TMP_LEFT else (left_token,)
+        try:
+            ops.unlink(path)
+        except Exception:
+            return (left_token,)
+        return ()
+
+    def _publish(self, lock, ctx, data):
+        ops = self._ops
+        target = self._managed(HISTORY_NAME)
+        tmp = self._managed(TMP_PREFIX + secrets.token_hex(16) + TMP_SUFFIX)
+        phase, fd, st, writer, failed = "tmp_create", None, None, None, False
+        try:
+            fd = ops.create_exclusive(tmp)
+            st = ops.fstat(fd)
+            writer = ops.open_writer(fd)
+            fd = None
+            phase = "write"
+            self._write_all(writer, data)
+            phase = "flush"
+            ops.flush(writer)
+            phase = "file_sync"
+            ops.fsync_file(writer)
+            phase = "close"
+            ops.close(writer)
+            writer = None
+        except Exception:
+            failed = True
+        if failed:
+            created = st is not None or fd is not None or writer is not None or phase != "tmp_create"
+            tokens = self._discard_own(tmp, st, writer, fd, CLEANUP_TMP_LEFT) if created else ()
+            raise LocalStoreError("store_io_error", "history", phase, cleanup=tokens)
+        if not self._owns(lock):
+            tokens = self._discard_own(tmp, st, None, None, CLEANUP_TMP_LEFT)
+            raise LocalStoreError("store_lock_ownership_lost", "lock", "lock_ownership", cleanup=tokens)
+        ctx.published = True
+        failed = False
+        try:
+            ops.replace(tmp, target)
+        except Exception:
+            failed = True
+        if failed:
+            tokens = self._discard_own(tmp, st, None, None, CLEANUP_TMP_LEFT)
+            raise LocalStoreError("store_commit_uncertain", "history", "replace", cleanup=tokens)
+        if self._durability == STRICT:
+            try:
+                ops.fsync_dir(self._dir)
+            except Exception:
+                failed = True
+            if failed:
+                raise LocalStoreError("store_commit_uncertain", "history", "dir_sync")
